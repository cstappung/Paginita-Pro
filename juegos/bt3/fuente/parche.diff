+    snprintf(path, sizeof(path), "gamedata/disc/SLUS_216.78");   /* el programa principal, sacado de la ISO */
+    elf = read_file(path, &elfSize);
+    if (elf == NULL || elfSize < 0x34 || memcmp(elf, "\177ELF", 4) != 0) {
+        data_fail("the game's program was not found", path);
+    }
+    {   /* sus secciones cargadas, como una sola imagen desde 0x100000 (igual que la versión de escritorio) */
+        uint32_t shoff, sh[6];
+        uint16_t shentsize, shnum;
+        memcpy(&shoff, elf + 0x20, 4);
+        memcpy(&shentsize, elf + 0x2E, 2);
+        memcpy(&shnum, elf + 0x30, 2);
+        srcSize[0] = ROM_END - ROM_BASE;
+        src[0] = calloc(1, srcSize[0]);
+        for (i = 0; i < shnum && (size_t)shoff + (size_t)(i + 1) * shentsize <= elfSize; i++) {
+            memcpy(sh, elf + shoff + (size_t)i * shentsize, sizeof(sh)); /* nombre, tipo, flags, dir, offset, tamaño */
+            if ((sh[2] & 2) && sh[1] != 8 && sh[5] != 0 && sh[3] >= ROM_BASE && sh[3] + sh[5] <= ROM_END &&
+                (size_t)sh[4] + sh[5] <= elfSize) {
+                memcpy(src[0] + (sh[3] - ROM_BASE), elf + sh[4], sh[5]);
+            }
+        }
+        free(elf);
+    }
+    snprintf(path, sizeof(path), "gamedata/disc/BIN/DBZP.BIN");  /* el programa de menús */
+    src[1] = read_file(path, &srcSize[1]);
+    if (src[1] == NULL) {
+        data_fail("the game's menu program was not found", path);
+    }
+    for (i = 0; i < gWebNumDatos; i++) {     /* cada trozo: copiarlo del disco a su lugar en la tabla */
+        const WebDato *d = &gWebDatos[i];
+        if (d->fuente > 1 || (size_t)d->off + d->largo > srcSize[d->fuente]) {
+            data_fail("damaged list of the game's data", NULL);
+        }
+        memcpy(d->dir, src[d->fuente] + d->off, d->largo);
+        for (k = 0; k < d->largo; k++) {
+            hash = (hash ^ src[d->fuente][d->off + k]) * 0x100000001B3ull;
+        }
+    }
+    free(src[0]);
+    free(src[1]);
+    if (hash != gWebSumaDatos) {
+        data_fail("the game's programs in your disc image are not the unmodified USA release (SLUS-21678)", NULL);
+    }
+}
+/* En la web, leer el disco detiene el programa hasta que la página trae los bytes (JSPI), y eso solo se puede
+   dentro de main: no en los constructores, que corren antes. El enlace envuelve Game_Main (-Wl,--wrap=Game_Main,
+   port/web/link.py), la primera función del juego que llama main, para rellenar las tablas justo antes. */
+extern void __real_Game_Main(void);
+/* El entorno de una pelea en línea (BT3_NET_SESSION, HOST o JOIN, RULES...). La página lo decide recién cuando
+   el anfitrión empieza, y para entonces el programa ya cargó: Emscripten copia ENV al entorno de C al arrancar
+   el runtime, así que cambiar ENV después no sirve (el juego abría el menú principal en vez del versus). Aquí,
+   al empezar el juego y antes de que nada lea el entorno, la página entrega las variables y se ponen con
+   setenv. `Module.entornoPendiente` es una lista de pares [nombre, valor] (juegos/bt3/pagina.js). */
+EM_JS(int, web_entorno_n, (void), { return (Module.entornoPendiente || []).length; });
+EM_JS(void, web_entorno_i, (int i, char *k, int kn, char *v, int vn), {
+    const e = Module.entornoPendiente[i];
+    stringToUTF8(String(e[0]), k, kn);
+    stringToUTF8(String(e[1]), v, vn);
+});
+static void web_pone_entorno(void) {
+    char k[64], v[256];
+    int i, n = web_entorno_n();
+    for (i = 0; i < n; i++) {
+        web_entorno_i(i, k, (int)sizeof(k), v, (int)sizeof(v));
+        setenv(k, v, 1);
+    }
+}
+/* El fin de cada pelea, para la página: el juego anota el ganador en BattleResult (BattleResult_Finish, llamado
+   desde battle.c al terminar). El enlace la envuelve (-Wl,--wrap=BattleResult_Finish) y, ya anotado, le cuenta a la
+   página los bits (1 ganó el lado 0 = jugador 1 / anfitrión, 2 ganó el lado 1, 4 empate, 8 se abandonó). En una
+   pelea en línea las dos copias calculan la misma pelea, así que las dos cuentan lo mismo: el torneo de la sala
+   anota solo al ganador cuando coinciden (juegos/bt3/pagina.js, Module.onFinBatalla). */
+extern void __real_BattleResult_Finish(void);
+extern int BattleResult_GetFlags(void);
+extern int BattleResult_GetReason(void);
+EM_JS(void, web_fin_batalla, (int bits), { if (Module.onFinBatalla) Module.onFinBatalla(bits); });
+void Web_PeleaTermina(void);
+void __wrap_BattleResult_Finish(void) {
+    __real_BattleResult_Finish();   /* (el aviso ya no va aquí: ver Web_FinPelea) */
+    Web_PeleaTermina();             /* (corre al salir de la escena de la pelea, Battle_Term: se acabó su música) */
+}
+/* La música de pelea propia (juegos/bt3/pagina.js, Module.onMusicaPelea): la página sabe cuándo empieza una pelea
+   (con el número de la canción que el juego eligió) y cuándo se sale de ella; mientras su canción suena, avisa con
+   Web_BgmPropia(1) y la música del juego calla (src/sys/adx.c). Web_MusicaPorcentaje: el volumen «Music» de Ajustes,
+   para que la canción de la página lo siga. */
+extern int gWebBgmPropia, gWebEnPelea, gPortMusicPercent;
+extern void Web_BgmAplica(void);
+EM_JS(void, web_musica_pelea, (int on, int bgm), { if (Module.onMusicaPelea) Module.onMusicaPelea(on, bgm); });
+void Web_PeleaEmpieza(int bgm) {
+    gWebEnPelea = 1;
+    web_musica_pelea(1, bgm);
+}
+void Web_PeleaTermina(void) {
+    if (!gWebEnPelea) return;
+    gWebEnPelea = 0;
+    Web_BgmAplica();
+    web_musica_pelea(0, 0);
+}
+EMSCRIPTEN_KEEPALIVE void Web_BgmPropia(int on) {
+    gWebBgmPropia = on != 0;
+    Web_BgmAplica();
+}
+EMSCRIPTEN_KEEPALIVE int Web_MusicaPorcentaje(void) { return gPortMusicPercent; }
+/* La pelea se decidió (K.O., tiempo, abandono): btl_seq.c lo llama una vez, en el cuadro en que la pelea termina.
+   Antes el aviso iba en BattleResult_Finish, que corre recién al SALIR de la escena de la pelea (Battle_Term): en
+   el versus, tras el combate el juego se queda en su pantalla de resultados y su menú de revancha, el aviso no
+   llegaba, y si alguien volvía a la sala el marco se recargaba sin avisar: el duelo quedaba «sin resultado». Los
+   bits forzados que Finish agrega después (motivo 0x20 / 0x40) se agregan aquí igual. */
+/* El final se terminó de mostrar (el K.O., la pose y la frase del ganador): btl_seq.c lo llama al entrar al estado del
+   menú de resultados. La sala espera esto para devolver a los jugadores, así la celebración se ve entera. */
+EM_JS(void, web_menu_fin, (void), { if (Module.onMenuFin) Module.onMenuFin(); });
+void Web_MenuFin(void) {
+    web_menu_fin();
+}
+void Web_FinPelea(void) {
+    int w = BattleResult_GetFlags(), r = BattleResult_GetReason();
+    if (r & 0x20) w |= 2;
+    if (r & 0x40) w |= 1;
+    web_fin_batalla(w);
+}
+void __wrap_Game_Main(void) {
+    web_pone_entorno();                /* primero: lo que la página decidió para esta pelea */
+    gPortStage = "reading the game's programs from the disc image";
+    Port_LoadGameData();               /* las tablas del juego, desde la ISO del jugador */
+    __real_Game_Main();                /* y el juego, como siempre */
+}
