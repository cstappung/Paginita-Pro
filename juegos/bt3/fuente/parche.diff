diff --git a/port/web/src/web_cxa.c b/port/web/src/web_cxa.c
new file mode 100644
index 0000000..d2bf244
--- /dev/null
+++ b/port/web/src/web_cxa.c
@@ -0,0 +1,16 @@
+/* Las dos funciones del runtime de C++ que usan las variables "static" locales de ui.cpp para inicializarse una
+   sola vez. El enlace es con emcc (C), no em++, así que no vienen solas. El programa web tiene un solo hilo:
+   basta con mirar y marcar el primer byte de la "guarda" que el compilador reserva para cada variable. */
+#include <stdint.h>
+
+int __cxa_guard_acquire(uint64_t *guarda) {
+    return *(volatile uint8_t *)guarda == 0;   /* 1 = aún no inicializada: el que llama la inicializa ahora */
+}
+
+void __cxa_guard_release(uint64_t *guarda) {
+    *(volatile uint8_t *)guarda = 1;           /* ya está inicializada: las próximas veces no se repite */
+}
+
+void __cxa_guard_abort(uint64_t *guarda) {
+    (void)guarda;                              /* la inicialización falló: se deja sin marcar para reintentar */
+}
