diff --git a/port/web/gen_data_skeleton.py b/port/web/gen_data_skeleton.py
new file mode 100644
index 0000000..5c56d46
--- /dev/null
+++ b/port/web/gen_data_skeleton.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Tablas de datos del juego para la build web SIN el disco: lo que hace gen_data_web.py, pero desde las tablas
+"en blanco" del port de escritorio (port/data/*.s) en vez de los archivos que splat saca del disco.
+
+Resumen: cada tabla trae solo su FORMA (etiquetas, tamaños, punteros). Sus valores son del juego y salen del disco
+del jugador al arrancar, como en la release de escritorio. Así el .wasm no contiene nada del juego y se puede
+publicar. Directivas: .space N (N bytes que vienen del disco), .zero N (ceros), .long X (puntero de 4 bytes).
+Se reescriben a ensamblador wasm (.skip / .int32, más .type/.size, que wasm exige) y por cada .space se anota
+(símbolo, desplazamiento, fuente, offset, largo) en port/build/gen/data_web/lista_datos.c; plat_mem.c lo recorre.
+Los punteros a funciones necesitan .functype (su firma, de port/build/obj_web/sigs.json, que hace build.py).
+
+Uso: port/web/gen_data_skeleton.py   -> port/build/obj_web/data_*.o y data_objects.txt (tras port/web/build.py)"""
+import json, pathlib, subprocess, sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+DST = ROOT / "port/build/gen/data_web"                   # los .s generados
+OBJ = ROOT / "port/build/obj_web"                        # los objetos, junto a los del resto del programa
+WASM = {"i1": "i32", "i8": "i32", "i16": "i32", "i32": "i32", "ptr": "i32", "i64": "i64", "float": "f32", "double": "f64"}
+ABSOLUTE = {"D_3BE71C": 0x3BE71C}                       # dato en una dirección fija de la PS2 (como irweb.py)
+ROM_BASE = 0x100000                                      # la fuente 0 (SLUS_216.78) se lee como imagen desde aquí
+
+
+def functype(nombre, sig):
+    """La declaración de firma que wasm necesita para guardar un puntero a función en datos."""
+    params = [WASM.get(t, "i32") for t in sig["params"]] + (["i32"] if sig["var"] else [])  # variádicas: +1 puntero
+    res = [] if sig["ret"] == "void" else [WASM.get(sig["ret"], "i32")]
+    return f"\t.functype\t{nombre} ({', '.join(params)}) -> ({', '.join(res)})"
+
+
+def main():
+    sigs = json.load(open(OBJ / "sigs.json"))           # firmas de todas las funciones definidas en el programa
+    indice, suma = {}, None
+    for l in (ROOT / "port/data/index.txt").read_text().splitlines():
+        p = l.split()
+        if not p or p[0].startswith("#"):
+            continue
+        if p[0] == "checksum":                           # el hash de los bytes del disco: comprueba que es el USA
+            suma = int(p[1], 16)
+        else:
+            indice[p[0]] = (int(p[1]), int(p[2], 16))   # tabla -> (fuente, offset de su primer byte)
+    DST.mkdir(parents=True, exist_ok=True)
+    # Qué nombres son DATOS: las etiquetas de las propias tablas y las variables globales definidas en el C.
+    # Un nombre al que apunta una tabla y que no es ninguna de las dos cosas ni una función definida es una
+    # función de biblioteca que la build todavía no tiene (link.py le hace un stub void(void)): wasm debe saberlo.
+    datos = {l.strip()[:-1] for f in (ROOT / "port/data").glob("*.s") for l in f.read_text().splitlines()
+             if l.strip().endswith(":")}
+    for ll in OBJ.glob("*.raw.ll"):
+        for l in ll.read_text(errors="replace").splitlines():
+            if l.startswith("@") and " = " in l and "external" not in l.split(" = ")[1][:40]:
+                datos.add(l[1:].split(" ")[0].strip('"'))
+    entradas, objetos = [], []
+    for f in sorted((ROOT / "port/data").glob("*.s")):
+        fuente, off = indice.get(f.stem, (2, 0))         # las .bss no están: solo tienen ceros
+        # (el offset de index.txt ya es la posición dentro de la imagen que empieza en 0x100000, no una dirección:
+        #  make_dat.py lo usa tal cual. Restarle ROM_BASE leía cada trozo del lugar equivocado.)
+        texto = f.read_text()
+        seccion = ".bss" if "\n.section .bss" in texto else ".data"
+        cuerpo, simbolos, funcs = [], [], set()
+        for linea in texto.splitlines():
+            t = linea.split("#")[0].strip()              # sin comentarios
+            if not t:
+                continue
+            if t.startswith(".section"):                 # una sección por tabla: el enlazador las ubica libremente
+                cuerpo.append(f'\t.section\t{seccion}.{f.stem.replace(".", "_")},"",@')
+            elif t.startswith((".p2align", ".globl")):
+                cuerpo.append("\t" + t)
+            elif t.endswith(":"):                        # empieza un símbolo; su tamaño se suma después
+                simbolos.append([t[:-1], 0])
+                cuerpo += [f"\t.type\t{t[:-1]},@object", f"\t.size\t{t[:-1]}, @@{t[:-1]}@@", t]
+            elif t.startswith((".space", ".zero")):
+                n = int(t.split()[1], 0)
+                if not simbolos:                         # relleno antes del primer símbolo: le damos uno propio
+                    pad = "WebPad_" + f.stem.replace(".", "_")
+                    simbolos.append([pad, 0])
+                    cuerpo += [f"\t.globl\t{pad}", f"\t.type\t{pad},@object", f"\t.size\t{pad}, @@{pad}@@", f"{pad}:"]
+                if t.startswith(".space") and seccion == ".data":
+                    entradas.append((simbolos[-1][0], simbolos[-1][1], fuente, off, n))  # viene del disco
+                cuerpo.append(f"\t.skip\t{n}")           # reserva n bytes en cero
+                simbolos[-1][1] += n
+                off += n
+            elif t.startswith(".long"):
+                v = t.split(None, 1)[1]
+                if v in ABSOLUTE:                        # se guarda su valor, no un símbolo
+                    v = hex(ABSOLUTE[v])
+                base = v.split("+")[0].split("-")[0]
+                if base not in sigs and base not in datos and not base.lstrip("-").isdigit() and not base.startswith("0x"):
+                    sigs[base] = {"ret": "void", "params": [], "var": False}  # función que aún falta (stub)
+                if base in sigs:                         # puntero a función: índice en la tabla de funciones
+                    funcs.add(base)
+                cuerpo.append(f"\t.int32\t{v}")
+                simbolos[-1][1] += 4
+                off += 4
+            else:
+                sys.exit(f"{f.name}: directiva desconocida: {t}")
+        for nombre, tam in simbolos:                     # ahora que se saben, los tamaños
+            cuerpo = [l.replace(f"@@{nombre}@@", str(tam)) for l in cuerpo]
+        s = DST / (f.stem + ".s")
+        s.write_text("\n".join([functype(n, sigs[n]) for n in sorted(funcs)] + cuerpo) + "\n")
+        o = OBJ / f"data_{f.stem.replace('.', '_')}.o"
+        r = subprocess.run(["emcc", "-c", str(s), "-o", str(o)], capture_output=True, text=True)
+        if r.returncode:
+            sys.exit(f"FALLÓ {s.name}: {r.stderr.strip()[:600]}")
+        objetos.append(str(o))
+    # La lista para el runtime: la dirección real la pone el enlazador (&símbolo + desplazamiento).
+    c = ["/* generado por port/web/gen_data_skeleton.py: qué bytes de las tablas salen del disco */",
+         "#include <stdint.h>", "typedef struct { uint8_t *dir; uint32_t fuente, off, largo; } WebDato;"]
+    c += [f"extern uint8_t {s}[];" for s in sorted({e[0] for e in entradas})]
+    c.append("const WebDato gWebDatos[] = {")
+    c += [f"    {{{s} + {d}, {fu}, 0x{o:X}, {n}}}," for s, d, fu, o, n in entradas]
+    c += ["};", f"const uint32_t gWebNumDatos = {len(entradas)};", f"const uint64_t gWebSumaDatos = 0x{suma:X}ull;"]
+    lc = DST / "lista_datos.c"
+    lc.write_text("\n".join(c) + "\n")
+    o = OBJ / "data_lista.o"
+    subprocess.run(["emcc", "-c", "-O2", str(lc), "-o", str(o)], check=True)
+    objetos.append(str(o))
+    (OBJ / "data_objects.txt").write_text("\n".join(objetos) + "\n")
+    print(f"{len(objetos)} objetos de datos; {len(entradas)} trozos ({sum(e[4] for e in entradas)} bytes) salen del disco")
+
+
+if __name__ == "__main__":
+    main()
