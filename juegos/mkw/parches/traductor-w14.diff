+    /// <summary>
+    /// W14 (§217): lo que de verdad lee y pisa una operación del CR, con los argumentos constantes que deja el traductor
+    /// (PpcLifter): crand/cror/crxor… = PPC_CrLogical(op, d, a, b) con bits 0–31 (el campo = bit / 4): lee los campos
+    /// de a, b y d (d se escribe a medias: los otros 3 bits de su campo pasan) y no pisa ninguno entero; crclr =
+    /// PPC_CrSetBit(bit, v): igual, su campo; mcrf = PPC_Mcrf(d, s): lee s, pisa d; mcrxr / mcrfs = pisan su campo;
+    /// mtcrf = «x_mtcrf_preserve = cr &amp; ~máscara»: no lee nada (lo de afuera de la máscara pasa tal cual) y pisa los
+    /// campos de la máscara (el bit i de la máscara de 32 bits es el campo 7 − i / 4). null = no es una de estas.
+    /// </summary>
+    private static (byte Pisa, byte Lee)? MkwCampoExacto(IrInstruction instruction)
+    {
+        static byte Campo(long bit) => (byte)(1 << (int)((bit & 31) / 4));
+        static byte Fld(long f) => (byte)(1 << (int)(f & 7));
+        static bool EsCr(string? n) => n is not null && RegisterNameUtils.HardwareBase(n.AsSpan()).Equals("cr", StringComparison.OrdinalIgnoreCase);
+        // las constantes (los registros, como «cr», que algunas formas pasan también como argumento, se saltan)
+        static long[] Consts(IReadOnlyList<IrValue> a) => a.Where(static v => v.Constant is not null).Select(static v => v.Constant!.Value).ToArray();
+        switch (instruction)
+        {
+            case IrCall c when EsCr(c.Destination):
+                {
+                    var k = Consts(c.Arguments);
+                    var t = c.Target.ToUpperInvariant();
+                    if (t is "PPC_CRLOGICAL" && k.Length == 4) return (0, (byte)(Campo(k[1]) | Campo(k[2]) | Campo(k[3])));
+                    if (t is "PPC_CRSETBIT" && k.Length == 2) return (0, Campo(k[0]));
+                    if (t is "PPC_MCRF" && k.Length == 2) return (Fld(k[0]), Fld(k[1]));
+                    if (t is "PPC_MCRXR" && k.Length == 1) return (Fld(k[0]), 0);
+                    if (t is "PPC_MCRFS" && k.Length == 2) return (Fld(k[0]), 0);
+                    return null;
+                }
+            case IrBinary { Op: "and", Left: { Kind: "register" } izq, Right.Constant: { } inv } b
+                when EsCr(izq.RegisterName) && b.Destination.Contains("mtcrf_preserve", StringComparison.Ordinal):
+                {
+                    var mascara = ~(uint)inv;
+                    byte pisa = 0;
+                    for (var f = 0; f < 8; ++f)
+                        if (((mascara >> ((7 - f) * 4)) & 0xF) != 0) pisa |= (byte)(1 << f);
+                    return (pisa, 0);
+                }
+            default:
+                return null;
+        }
+    }
