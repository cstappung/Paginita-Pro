+/// <summary>
+/// MKW banderas (W14, bitácora §217): las direcciones que pueden ser destino de una llamada indirecta, de más (nunca de
+/// menos): las que están guardadas en los datos del DOL y del REL (tablas virtuales, callbacks) y toda constante que el
+/// código arma con «lis rD,H» seguido (hasta 8 instrucciones) de «addi rX,rD,L» u «ori rX,rD,L» y cae en código
+/// ejecutable, se use como se use después. Las funciones del mod se suman aparte (todas). Lo escribe en
+/// build/mkw-banderas-indirectas.txt para el vigía del runtime (MKW_VIGIA_INDIRECTAS), que avisa si en la carrera una
+/// indirecta va a una dirección que no está.
+/// </summary>
+HashSet<uint> MkwIndirectables()
+{
+    var set = CollectDataSectionFunctionPointerTargets();
+    var desdeDatos = set.Count;
+    var ranges = BuildExecutableRanges();
+    bool Exe(uint a) => (a & 3) == 0 && ranges.Any(r => r.Contains(a));
+    var mem = image.Value.Memory;
+    foreach (var r in ranges)
+    {
+        if (!image.Value.Contains(r.Start, checked((int)r.Length))) continue;
+        var off = image.Value.GetOffset(r.Start, checked((int)r.Length));
+        var n = (int)(r.Length / 4);
+        for (var i = 0; i < n; ++i)
+        {
+            var w = BinaryPrimitives.ReadUInt32BigEndian(mem.AsSpan(off + i * 4, 4));
+            if ((w >> 26) != 15 || ((w >> 16) & 31) != 0) continue;          // lis rD, H (addis rD, 0, H)
+            var rd = (w >> 21) & 31;
+            var alto = (w & 0xFFFF) << 16;
+            for (var k = 1; k <= 8 && i + k < n; ++k)
+            {
+                var v = BinaryPrimitives.ReadUInt32BigEndian(mem.AsSpan(off + (i + k) * 4, 4));
+                var op = v >> 26;
+                uint valor;
+                if (op == 14 && ((v >> 16) & 31) == rd) valor = alto + (uint)(short)(v & 0xFFFF);        // addi rX, rD, L
+                else if (op == 24 && ((v >> 21) & 31) == rd) valor = alto | (v & 0xFFFF);                // ori rX, rD, L
+                else continue;
+                if (Exe(valor)) set.Add(valor);
+            }
+        }
+    }
+    Directory.CreateDirectory("build");
+    File.WriteAllLines(Path.Combine("build", "mkw-banderas-indirectas.txt"),
+        set.OrderBy(static a => a).Select(static a => a.ToString("X8")));
+    Console.WriteLine($"[translator] MKW banderas: {set.Count:N0} posibles destinos de una indirecta " +
+                      $"({desdeDatos:N0} de los datos, el resto armados en el código) → build/mkw-banderas-indirectas.txt");
+    return set;
+}
