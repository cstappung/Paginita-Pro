diff --git a/web/navegador/solo-dibuja.mjs b/web/navegador/solo-dibuja.mjs
new file mode 100644
index 0000000..1f0991a
--- /dev/null
+++ b/web/navegador/solo-dibuja.mjs
@@ -0,0 +1,109 @@
+// W24 del plan de rendimiento v4 (bitácora §227): «el teléfono solo dibuja». Opción del jugador, APAGADA por omisión.
+//
+// Qué es: en la sala, un teléfono que no alcanza a simular 60 cuadros por segundo deja de calcular la carrera. Un PC de la
+// sala corre la consola de ese teléfono por él (con lockstep, como hoy) y cada cuadro le manda la caja de W10 (§207: la
+// memoria de la Wii que cambió, ~90 KB). El teléfono pega la caja y solo dibuja, nítido a su propia resolución; manda
+// solo sus botones. Como un tablero remoto que solo tiene las lámparas: el PLC está en la sala de control y por el cable
+// llegan las lecturas, y de vuelta van los pulsadores.
+//
+// Este archivo es la parte PURA de la página (sin el juego; banco `solo-dibuja`):
+//   - quiereSoloDibuja(parametros, graficos): ?soloDibuja=0|1 manda; si no, lo guardado en Gráficos (mkw.graficos);
+//   - subidaMbit(kbPorCuadro): lo que el PC tiene que subir por cada teléfono a 60 cuadros por segundo;
+//   - elegirCalculador(consolas, {mbit}): el PC más capaz (como la autoridad por capacidad de §179): no un teléfono, que
+//     se oiga, que su subida alcance y con el mayor margen por cuadro; null si ninguno sirve;
+//   - crearVigia({plazoMs}): si las cajas dejan de llegar, el teléfono vuelve SOLO a simular (camino normal) y no lo
+//     reintenta en esa carrera;
+//   - crearDemora(): la demora del botón a la imagen: el teléfono sella cada botón con su hora, la caja dice qué botón
+//     ya entró en la carrera y al dibujarla se resta;
+//   - decidir(...): qué hace este teléfono ahora («dibuja» o «simula») y por qué (el motivo va al registro y al panel).
+
+// --- la opción ---
+export const CLAVE_OPCION = 'soloDibuja';
+// ?soloDibuja=1 / =0 gana; sin el parámetro vale lo guardado en Gráficos (apagado si nunca se tocó)
+export function quiereSoloDibuja(parametros, graficos = {}) {
+  const p = parametros?.get?.(CLAVE_OPCION);
+  if (p === '1') return true;
+  if (p === '0') return false;
+  return graficos?.soloDibuja === true;
+}
+
+// --- la red ---
+// Mbit/s que pide una caja de kb KB por cuadro a 60 cuadros por segundo (+ 5 % de cabeceras de WebRTC: SCTP/DTLS/UDP)
+export const subidaMbit = (kbPorCuadro, cuadros = 60) => kbPorCuadro * 1024 * 8 * cuadros * 1.05 / 1e6;
+
+// consolas = [{ uid, telefono, oido, margenMs, subidaMbit, calculaPor = [] }]: margenMs = lo que le sobra por cuadro a
+// 60 (16,7 ms − su trabajo; §179 lo lleva en el informe del lockstep), subidaMbit = lo que puede subir (medido), calculaPor
+// = los teléfonos que ya atiende (cada uno le come la mitad del margen de la carrera sin dibujo, §207: ×2–3,5 sin dibujar)
+export const MARGEN_MIN_MS = 4;   // menos que esto, el PC frenaría a la sala si corre otra consola más
+export function elegirCalculador(consolas = [], { mbit = 0, costoMs = 4 } = {}) {
+  const sirven = consolas.filter(c => !c.telefono && c.oido !== false &&
+    (c.subidaMbit ?? 0) >= mbit * ((c.calculaPor?.length ?? 0) + 1) &&
+    (c.margenMs ?? 0) - costoMs * ((c.calculaPor?.length ?? 0) + 1) >= MARGEN_MIN_MS);
+  if (!sirven.length) return null;
+  sirven.sort((a, b) => (b.margenMs - costoMs * (b.calculaPor?.length ?? 0)) - (a.margenMs - costoMs * (a.calculaPor?.length ?? 0)) ||
+                        (b.subidaMbit - a.subidaMbit) || String(a.uid).localeCompare(String(b.uid)));
+  return sirven[0].uid;
+}
+
+// --- la vigía: si no llegan cajas, volver a simular ---
+// estado: 'esperando' (todavía no llegó la primera), 'bien', 'caida' (no llegó nada en plazoMs: vuelve a simular y no
+// lo reintenta hasta rearmar(), que la página llama al empezar la carrera siguiente)
+export function crearVigia({ plazoMs = 500, primeraMs = 15000, ahora = () => performance.now() } = {}) {
+  let estado = 'esperando', ultima = ahora(), desde = ahora(), cuadro = -1, caidas = 0, motivo = '';
+  return {
+    get estado() { return estado; }, get caidas() { return caidas; }, get motivo() { return motivo; },
+    llego(c) {
+      if (estado === 'caida') return false;            // (ya volví a simular: lo que llegue tarde no se pega)
+      if (c <= cuadro) return false;                   // (repetida o vieja)
+      cuadro = c; ultima = ahora(); estado = 'bien';
+      return true;
+    },
+    revisar() {
+      const t = ahora();
+      if (estado === 'bien' && t - ultima > plazoMs) { estado = 'caida'; caidas++; motivo = `sin cajas ${Math.round(t - ultima)} ms`; }
+      else if (estado === 'esperando' && t - desde > primeraMs) { estado = 'caida'; caidas++; motivo = `la primera caja no llegó en ${Math.round(t - desde)} ms`; }
+      return estado;
+    },
+    rearmar() { estado = 'esperando'; ultima = desde = ahora(); cuadro = -1; motivo = ''; },
+  };
+}
+
+// --- la demora del botón a la imagen ---
+// boton(n) = el teléfono manda su botón número n (a la hora de ahora); imagen(n) = dibujé una caja que ya trae el botón
+// n: la demora es la resta. resumen() = la última, la media y la peor del último segundo (para el medidor).
+export function crearDemora({ ahora = () => performance.now(), tope = 512 } = {}) {
+  const sellos = new Map();
+  let ultimo = -1, ultima = null;
+  const ventana = [];
+  return {
+    boton(n) { sellos.set(n, ahora()); if (sellos.size > tope) sellos.delete(sellos.keys().next().value); },
+    imagen(n) {
+      if (n <= ultimo) return null;
+      const t = ahora();
+      let ms = null;
+      for (const [k, h] of sellos) { if (k > n) break; if (k > ultimo) ms = t - h; sellos.delete(k); }
+      ultimo = n;
+      if (ms !== null) { ultima = ms; ventana.push([t, ms]); }
+      while (ventana.length && t - ventana[0][0] > 1000) ventana.shift();
+      return ms;
+    },
+    resumen() {
+      if (!ventana.length) return { ultima, media: null, peor: null };
+      const v = ventana.map(x => x[1]);
+      return { ultima, media: v.reduce((s, x) => s + x, 0) / v.length, peor: Math.max(...v) };
+    },
+  };
+}
+export const textoDemora = r => r?.media == null ? '' : `botón→imagen ${Math.round(r.media)} ms (peor ${Math.round(r.peor)})`;
+
+// --- qué hace este teléfono ahora ---
+// quiere: la opción; enSala: solo en la sala (jugando solo no hay PC que calcule); programa: el programa trae el bucle
+// propio del dibujo (Module._mkw_w24_dato); calculador: el uid elegido (null = ninguno sirve); vigia: el estado.
+export function decidir({ quiere, enSala, programa, calculador, vigia = 'esperando' }) {
+  if (!quiere) return { modo: 'simula', motivo: 'opción apagada' };
+  if (!enSala) return { modo: 'simula', motivo: 'solo en la sala' };
+  if (!programa) return { modo: 'simula', motivo: 'este programa no trae el dibujo solo (W24)' };
+  if (!calculador) return { modo: 'simula', motivo: 'ningún PC de la sala puede calcular por ti' };
+  if (vigia === 'caida') return { modo: 'simula', motivo: 'se cortó la red con el PC: vuelvo a simular' };
+  return { modo: 'dibuja', motivo: `calcula ${calculador}` };
+}
