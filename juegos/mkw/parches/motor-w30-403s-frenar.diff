+// MKW RETRO (§269b.16): the room's brake. The retrace grid is absolute (each retrace is stamped on its grid time, not
+// on when it ran), so a frame the page held back inside the lockstep was won back right after: the next retraces
+// were already due and ran back to back. Measured (2 PCs + the phone): 564 frames braked in 40 s slowed the room by
+// 46; the rest were only hitches. This moves the grid forward `ms` instead: the frame in course is not held, the next
+// retrace is due `ms` later and nothing runs back to back to undo it (like retarding the timing of a motor instead
+// of braking its shaft and letting the governor speed it back up). Whatever catch-up was pending is cancelled first
+extern "C" EMSCRIPTEN_KEEPALIVE void mkw_frenar(double ms) {
+    if (!(ms > 0.0)) return;
+    if (ms > 500.0) ms = 500.0;
+    std::lock_guard<std::mutex> lock(g_viMutex);
+    if (!g_vi.initialized) return;
+    s_mkwPrisaMs = 0.0;
+    g_vi.lastRetrace += std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double, std::milli>(ms));
+    s_mkwFrenadoMs += ms;
+}
+extern "C" EMSCRIPTEN_KEEPALIVE double mkw_frenado() { return s_mkwFrenadoMs; }
