+// MKW M8 vigía (solo la copia de experimento terceros/Wiicompiled-motor-m8): la lista de funciones que devuelven
+// r14-r31 distintos de como los recibieron (rompen la regla de la Wii). Cada una se imprime una vez, con la máscara de
+// registros cambiados; cada 64 veces más, otra línea con la cuenta. Ver herramientas/tanda-m8.sh y la bitácora (M8).
+#include <cstdint>
+#include <cstdio>
+#include <unordered_map>
+
+extern "C" void mkw_m8_violacion(uint32_t target, uint32_t mask) noexcept {
+    static std::unordered_map<uint32_t, uint64_t> vistas;   // destino -> veces
+    uint64_t& n = vistas[target];
+    ++n;
+    if (n == 1 || (n & 63) == 0) {
+        std::printf("[m8-vigia] 0x%08X mascara 0x%08X veces %llu\n", target, mask, static_cast<unsigned long long>(n));
+        std::fflush(stdout);
+    }
+}
