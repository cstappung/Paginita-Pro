+    /// <summary>
+    /// MKW M8 (bitácora del proyecto): MKW_M8=techo is a deliberately UNSAFE ceiling measurement. After a guest call
+    /// (direct or indirect) it skips reloading r14-r31: the EABI makes every callee restore them, so the locals still
+    /// hold the right values unless something breaks the ABI (context switches, longjmp, hand-written mod code).
+    /// Only for measuring how much the reloads cost; unset = the translator as always.
+    /// </summary>
+    internal static readonly string? MkwM8Mode = Environment.GetEnvironmentVariable("MKW_M8");
+    private const uint MkwNonVolatileGprMask = 0xFFFFC000u;   // r14-r31
+
+    // Only the FULL reloads (indirect calls, callees with a full-sync fence): a call with a precise contract already
+    // reloads exactly what the callee can write, and some callees DO write r14-r31 on purpose (the _restgpr_N epilogue
+    // helpers load them from the stack). Stripping those too froze the game at boot (section 0x3f).
+    // MKW_M8=techo (both kinds), ind (only after indirect calls), dir (only after direct calls with a full fence):
+    // the full-mode ceiling froze the game at boot, so the two halves are measured apart to find which one breaks.
+    // MKW_M8_EXCLUIR = hex guest addresses (comma separated) whose direct calls keep the full reload (thread switches,
+    // context save/load: they resume a thread with r14-r31 as they were at another moment, like setjmp/longjmp).
+    // Entries are single addresses or inclusive ranges "lo-hi" (e.g. the Retro Rewind module, 81800000-81ffffff).
+    private static readonly (uint Lo, uint Hi)[] MkwM8Excluded =
+        (Environment.GetEnvironmentVariable("MKW_M8_EXCLUIR") ?? "")
+            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
+            .Select(x => x.Split('-'))
+            .Select(p => (Convert.ToUInt32(p[0], 16), Convert.ToUInt32(p[^1], 16)))
+            .ToArray();
+
+    private static bool MkwM8IsExcluded(uint target) => MkwM8Excluded.Any(r => target >= r.Lo && target <= r.Hi);
+
+    // MKW_M8=seguro: only after DIRECT calls, and never after a call to code a mod can replace (the 975
+    // modOverridableCallTargets, i.e. Retro Rewind overlays) nor to the excluded addresses (MKW_M8_EXCLUIR: the OS
+    // thread switches and the Retro Rewind module 81800000-81ffffff). The vigía run (MKW_M8=vigia) found that every
+    // function on the boot-to-race path that returns r14-r31 changed is Retro Rewind code.
+    private static bool MkwM8Strips(ResidencyBoundarySync sync, bool indirect, uint target, bool modOverridable) =>
+        sync.ReloadGprMask == uint.MaxValue && (indirect || !MkwM8IsExcluded(target)) &&
+        (MkwM8Mode == "techo" || (MkwM8Mode == "ind" && indirect) || (MkwM8Mode == "dir" && !indirect) ||
+         (MkwM8Mode == "seguro" && !indirect && !modOverridable && !_mkwM8ModCode));
+
+    // True while emitting a mod translation (Retro Rewind overlays, Kamek hooks, rr_continue_* continuations): the
+    // second vigía run found mod code calling continuations, which run the rest of a game function including its
+    // epilogue (r14-r31 restored from that function's frame), so calls made from mod code keep the full reload.
+    [ThreadStatic]
+    internal static bool _mkwM8ModCode;
+
+    // MKW_M8_VIGIA=1 with a stripping mode: keep the full reload but put the vigía check exactly where the mode would
+    // strip (a report = that mode would read a stale register there). MKW_M8=vigia alone checks every full reload.
+    private static readonly bool MkwM8VigiaOnly = Environment.GetEnvironmentVariable("MKW_M8_VIGIA") == "1";
+
+    private static ResidencyBoundarySync MkwM8AfterGuestCall(ResidencyBoundarySync sync, bool indirect = false, uint target = 0,
+        bool modOverridable = false) =>
+        !MkwM8VigiaOnly && MkwM8Strips(sync, indirect, target, modOverridable)
+            ? sync with { ReloadGprMask = sync.ReloadGprMask & ~MkwNonVolatileGprMask } : sync;
+
