+// MKW RETRO (W9, bitácora §205): el camino de reserva para las Adreno 6xx/7xx, apagado por omisión. En KartPad los
+// personajes salían invisibles en esas tarjetas, por cómo su controlador de Vulkan indexa un arreglo de matrices de
+// un búfer de uniformes con un índice que viene del vértice (los huesos). Con g_mkwHuesosFilas las matrices
+// postex_mtx y nrm_mtx se declaran como filas sueltas (array<vec4f, 3N>: los mismos bytes, stride 16 en vez de 48) y
+// cada matriz se arma con sus 3 filas: la misma cuenta, el mismo resultado, otra forma de leerla para el controlador.
+bool g_mkwHuesosFilas = false;
+static void huesos_por_filas(std::string& s) {
+  for (const std::string_view nombre : {"postex_mtx"sv, "nrm_mtx"sv}) {
+    // la declaración: «postex_mtx: array<mat3x4f, N>,» → «postex_mtx: array<vec4f, 3N>,»
+    const std::string decl = fmt::format("{}: array<mat3x4f, ", nombre);
+    if (const auto p = s.find(decl); p != std::string::npos) {
+      const auto q = s.find('>', p);
+      const unsigned n = std::stoul(s.substr(p + decl.size(), q - p - decl.size()));
+      s.replace(p, q + 1 - p, fmt::format("{}: array<vec4f, {}>", nombre, n * 3));
+    }
+    // cada uso: «ubuf.postex_mtx[E]» → «mat3x4f(ubuf.postex_mtx[(E)*3u], …[(E)*3u+1u], …[(E)*3u+2u])»
+    const std::string uso = fmt::format("ubuf.{}[", nombre);
+    for (size_t p = s.find(uso); p != std::string::npos; p = s.find(uso, p)) {
+      size_t i = p + uso.size();
+      int nivel = 1;
+      for (; i < s.size() && nivel; i++) nivel += s[i] == '[' ? 1 : s[i] == ']' ? -1 : 0;
+      const std::string e = s.substr(p + uso.size(), i - 1 - p - uso.size());
+      const std::string nuevo = fmt::format("mat3x4f(ubuf.{0}[({1})*3u], ubuf.{0}[({1})*3u+1u], ubuf.{0}[({1})*3u+2u])", nombre, e);
+      s.replace(p, i - p, nuevo);
+      p += nuevo.size();
+    }
+  }
+}
