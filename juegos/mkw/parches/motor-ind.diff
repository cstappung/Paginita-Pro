+/// <summary>
+/// MKW §282: every guest address an indirect call (<c>bctrl</c>/<c>bctr</c>) can reach, as a superset. A target
+/// address has to exist somewhere as a value: (1) a 32-bit word anywhere in the loaded DOL+REL image (vtables,
+/// dispatch tables, callback fields in .data/.sdata, already relocated for the REL); (2) a constant the code builds
+/// with <c>lis</c> + <c>addi</c>/<c>ori</c> (or <c>lis</c> alone), tracked per register without control flow so a
+/// stale pairing only adds candidates; (3) a value the mod's Kamek stream writes or relocates into the image or its
+/// own code (pointer writes, 16-bit address halves, raw 32-bit writes, words of its code blob). Anything that is not
+/// a translated or native function entry cannot be dispatched and is dropped. Over-approximation is safe: more
+/// candidates only widen the contract.
+/// </summary>
+HashSet<uint> CollectIndirectTargetCandidates(IReadOnlySet<uint> entries, out string report)
+{
+    var found = new HashSet<uint>();
+    int fromWords = 0, fromCode = 0, fromMod = 0;
+    void Take(uint value, ref int counter)
+    {
+        if (entries.Contains(value) && found.Add(value)) counter++;
+    }
+
+    var memory = image.Value.Memory;
+    var memoryBase = image.Value.MemoryBase;
+    for (var offset = 0; offset + 4 <= memory.Length; offset += 4)
+    {
+        Take(BinaryPrimitives.ReadUInt32BigEndian(memory.AsSpan(offset, 4)), ref fromWords);
+    }
+
+    var high = new uint?[32];
+    foreach (var range in BuildExecutableRanges())
+    {
+        Array.Clear(high);
+        for (var address = range.Start; address + 4 <= range.End; address += 4)
+        {
+            if (!image.Value.Contains(address, 4)) continue;
+            var word = BinaryPrimitives.ReadUInt32BigEndian(memory.AsSpan(checked((int)(address - memoryBase)), 4));
+            var opcode = word >> 26;
+            var rd = (int)((word >> 21) & 31);
+            var ra = (int)((word >> 16) & 31);
+            var imm = word & 0xFFFF;
+            if (opcode == 15 && ra == 0)                       // lis rD, imm
+            {
+                high[rd] = imm << 16;
+                Take(imm << 16, ref fromCode);
+            }
+            else if (opcode == 14 && ra != 0 && high[ra] is { } h)   // addi rD, rA, simm
+            {
+                Take(unchecked(h + (uint)(short)imm), ref fromCode);
+            }
+            else if (opcode == 24 && high[rd] is { } hs)            // ori rA, rS, uimm (rS is bits 21-25)
+            {
+                Take(hs | imm, ref fromCode);
+            }
+        }
+    }
+
+    foreach (var patchProfile in modPatchProfiles.Value)
+    {
+        var chunk = Translator.Core.Parsing.Kamek.KamekPulFile.Load(patchProfile.CodePul!)
+            .SelectRegion(string.IsNullOrWhiteSpace(patchProfile.Region) ? "P" : patchProfile.Region!);
+        for (var offset = 0; offset + 4 <= chunk.CodeBlob.Length; offset += 4)
+        {
+            Take(BinaryPrimitives.ReadUInt32BigEndian(chunk.CodeBlob.AsSpan(offset, 4)), ref fromMod);
+        }
+        var moduleBase = patchProfile.ModuleGuestBase ?? 0x81700000u;
+        foreach (var command in chunk.Commands)
+        {
+            foreach (var argument in command.Arguments)
+            {
+                Take(argument, ref fromMod);
+                if (argument < 0x80000000u) Take(unchecked(moduleBase + argument), ref fromMod);
+            }
+        }
+    }
+
+    report = $"{found.Count:N0} candidate target(s): {fromWords:N0} image words, {fromCode:N0} code constants, {fromMod:N0} from the mod";
+    return found;
+}
+
 TranslationProjectConfig RequireProject() => project ?? throw new InvalidOperationException(
     "This command requires --project <path>. See projects/mkwii/recomp.yml for an example.");
 
