diff --git a/translator/src/Translator.Core/Analysis/IndirectCallPolicy.cs b/translator/src/Translator.Core/Analysis/IndirectCallPolicy.cs
new file mode 100644
index 0000000..34dfcef
--- /dev/null
+++ b/translator/src/Translator.Core/Analysis/IndirectCallPolicy.cs
@@ -0,0 +1,197 @@
+using System;
+using System.Globalization;
+
+namespace Translator.Core.Analysis;
+
+/// <summary>
+/// MKW §282: what a translated function may assume about an indirect call (<c>bctrl</c> / <c>bctr</c>).
+/// Upstream treats every indirect call as a full synchronization fence: it reads and writes the complete
+/// guest state, so the caller's contract becomes "everything" and that spreads to every function above it.
+///
+/// <c>MKW_IND</c> selects the policy (read once per translator process):
+/// <list type="bullet">
+/// <item><c>0</c> (default) — upstream: full fence.</item>
+/// <item><c>techo</c> — the optimistic ceiling, only for measuring: every indirect target is assumed to
+/// follow the PowerPC EABI (only volatile state changes, r1/r2/r13, r14-r31, f14-f31 and cr2-cr4 come back
+/// unchanged) and never needs a complete context. Not proven.</item>
+/// <item><c>cerca</c> — only the fence is dropped: the call still may write every register.</item>
+/// <item><c>prueba</c> — the proven contract: the union of the contracts of every function an indirect call can
+/// reach (see <see cref="IndirectTargetContract"/>); set by the translator after the interprocedural pass.</item>
+/// </list>
+/// </summary>
+public static class IndirectCallPolicy
+{
+    public enum Mode { Upstream, Ceiling, NoFence, Proven }
+
+    public static readonly Mode Current = Parse(Environment.GetEnvironmentVariable("MKW_IND"));
+
+    private static Mode Parse(string? text) => (text ?? "0").Trim().ToLowerInvariant() switch
+    {
+        "techo" => Mode.Ceiling,
+        "cerca" => Mode.NoFence,
+        "prueba" => Mode.Proven,
+        _ => Mode.Upstream,
+    };
+
+    public static bool Enabled => Current != Mode.Upstream;
+
+    // EABI volatile state (what a conforming callee may leave changed).
+    public const uint VolatileGpr = 0x00001FF9u;   // r0, r3-r12
+    public const uint VolatileFpr = 0x00003FFFu;   // f0-f13
+    public const byte VolatileCr = 0xE3;           // cr0, cr1, cr5, cr6, cr7 (bit i = field i)
+
+    /// <summary>
+    /// The contract an indirect call site uses in <see cref="Mode.Proven"/>: written once by the translator
+    /// (union of every possible target), read by the per-function analyzer and by the code generator.
+    /// Null until set; while null the proven mode falls back to the upstream fence.
+    /// </summary>
+    public static GuestAbiContract? IndirectTargetContract { get; set; }
+
+    /// <summary>The contract an indirect call or tail dispatch is analysed and emitted with, or null = full fence.</summary>
+    public static GuestAbiContract? Contract => Current switch
+    {
+        Mode.Ceiling => CeilingContract,
+        Mode.NoFence => NoFenceContract,
+        Mode.Proven => IndirectTargetContract,
+        _ => null,
+    };
+
+    private static readonly GuestAbiContract CeilingContract = Build(VolatileGpr, VolatileFpr, VolatileCr, gqrHid: false);
+    private static readonly GuestAbiContract NoFenceContract = Build(uint.MaxValue, uint.MaxValue, 0xFF, gqrHid: true);
+
+    private static GuestAbiContract Build(uint gpr, uint fpr, byte cr, bool gqrHid) => new(
+        GprReadBeforeWriteMask: uint.MaxValue,
+        GprPossibleWriteMask: gpr,
+        GprReturnMask: gpr & ((1u << 3) | (1u << 4)),
+        FprReadBeforeWriteMask: uint.MaxValue,
+        FprPossibleWriteMask: fpr,
+        FprReturnMask: fpr & (1u << 1),
+        CrReadBeforeWriteMask: 0xFF,
+        CrPossibleWriteMask: cr,
+        ReadsXerBeforeWrite: true,
+        MayWriteXer: true,
+        ReadsCtrBeforeWrite: true,
+        MayWriteCtr: true,
+        ReadsLrBeforeWrite: true,
+        MayWriteLr: true,
+        BoundaryFlags: GuestCallBoundaryFlags.None,
+        DirectCallTargets: Array.Empty<uint>())
+    {
+        ReadsFpscrBeforeWrite = true,
+        MayWriteFpscr = true,
+        GqrReadBeforeWriteMask = 0xFF,
+        GqrPossibleWriteMask = gqrHid ? (byte)0xFF : (byte)0,
+        HidReadBeforeWriteMask = 0xFF,
+        HidPossibleWriteMask = gqrHid ? (byte)0x07 : (byte)0,
+    };
+
+    /// <summary>The contract of a call that does nothing: the bottom of the §282 fixpoint.</summary>
+    public static readonly GuestAbiContract Empty = new(0, 0, 0, 0, 0, 0, 0, 0, false, false, false, false, false, false,
+        GuestCallBoundaryFlags.None, Array.Empty<uint>());
+
+    /// <summary>
+    /// What a call to "one of a or b" may do: every read and possible write of either, every boundary flag of either;
+    /// a write is definite only if both make it.
+    /// </summary>
+    public static GuestAbiContract Union(GuestAbiContract a, GuestAbiContract b) => new(
+        a.GprReadBeforeWriteMask | b.GprReadBeforeWriteMask,
+        a.GprPossibleWriteMask | b.GprPossibleWriteMask,
+        a.GprReturnMask | b.GprReturnMask,
+        a.FprReadBeforeWriteMask | b.FprReadBeforeWriteMask,
+        a.FprPossibleWriteMask | b.FprPossibleWriteMask,
+        a.FprReturnMask | b.FprReturnMask,
+        (byte)(a.CrReadBeforeWriteMask | b.CrReadBeforeWriteMask),
+        (byte)(a.CrPossibleWriteMask | b.CrPossibleWriteMask),
+        a.ReadsXerBeforeWrite || b.ReadsXerBeforeWrite,
+        a.MayWriteXer || b.MayWriteXer,
+        a.ReadsCtrBeforeWrite || b.ReadsCtrBeforeWrite,
+        a.MayWriteCtr || b.MayWriteCtr,
+        a.ReadsLrBeforeWrite || b.ReadsLrBeforeWrite,
+        a.MayWriteLr || b.MayWriteLr,
+        a.BoundaryFlags | b.BoundaryFlags,
+        Array.Empty<uint>())
+    {
+        ReadsFpscrBeforeWrite = a.ReadsFpscrBeforeWrite || b.ReadsFpscrBeforeWrite,
+        MayWriteFpscr = a.MayWriteFpscr || b.MayWriteFpscr,
+        GqrReadBeforeWriteMask = (byte)(a.GqrReadBeforeWriteMask | b.GqrReadBeforeWriteMask),
+        GqrPossibleWriteMask = (byte)(a.GqrPossibleWriteMask | b.GqrPossibleWriteMask),
+        HidReadBeforeWriteMask = (byte)(a.HidReadBeforeWriteMask | b.HidReadBeforeWriteMask),
+        HidPossibleWriteMask = (byte)(a.HidPossibleWriteMask | b.HidPossibleWriteMask),
+        // Definite writes stay empty: the bottom of the fixpoint would otherwise make every write "definite".
+    };
+
+    /// <summary>True when b adds nothing to a (the fixpoint test).</summary>
+    public static bool Covers(GuestAbiContract a, GuestAbiContract b)
+    {
+        var u = Union(a, b);
+        return u.GprReadBeforeWriteMask == a.GprReadBeforeWriteMask && u.GprPossibleWriteMask == a.GprPossibleWriteMask &&
+            u.GprReturnMask == a.GprReturnMask && u.FprReadBeforeWriteMask == a.FprReadBeforeWriteMask &&
+            u.FprPossibleWriteMask == a.FprPossibleWriteMask && u.FprReturnMask == a.FprReturnMask &&
+            u.CrReadBeforeWriteMask == a.CrReadBeforeWriteMask && u.CrPossibleWriteMask == a.CrPossibleWriteMask &&
+            u.ReadsXerBeforeWrite == a.ReadsXerBeforeWrite && u.MayWriteXer == a.MayWriteXer &&
+            u.ReadsCtrBeforeWrite == a.ReadsCtrBeforeWrite && u.MayWriteCtr == a.MayWriteCtr &&
+            u.ReadsLrBeforeWrite == a.ReadsLrBeforeWrite && u.MayWriteLr == a.MayWriteLr &&
+            u.BoundaryFlags == a.BoundaryFlags && u.ReadsFpscrBeforeWrite == a.ReadsFpscrBeforeWrite &&
+            u.MayWriteFpscr == a.MayWriteFpscr && u.GqrReadBeforeWriteMask == a.GqrReadBeforeWriteMask &&
+            u.GqrPossibleWriteMask == a.GqrPossibleWriteMask && u.HidReadBeforeWriteMask == a.HidReadBeforeWriteMask &&
+            u.HidPossibleWriteMask == a.HidPossibleWriteMask;
+    }
+
+    /// <summary>
+    /// The contracts of the mod's functions from a translate-mod resolved dispatch profile (entries whose Kind is
+    /// not "base"), keyed by guest address. The profile does not carry CTR/LR/FPSCR/GQR/HID or the individual
+    /// boundary flags, so those are taken at their widest: read and written, and a fence becomes
+    /// RequiresCompleteContext. Empty when the path is unset or missing.
+    /// </summary>
+    public static Dictionary<uint, GuestAbiContract> LoadModContracts(string? path, out string report)
+    {
+        var result = new Dictionary<uint, GuestAbiContract>();
+        if (string.IsNullOrWhiteSpace(path) || !System.IO.File.Exists(path))
+        {
+            report = "none (MKW_IND_RR unset or missing)";
+            return result;
+        }
+
+        using var document = System.Text.Json.JsonDocument.Parse(System.IO.File.ReadAllBytes(path));
+        int fenced = 0;
+        foreach (var entry in document.RootElement.GetProperty("Entries").EnumerateArray())
+        {
+            if (entry.GetProperty("Kind").GetString() == "base") continue;
+            uint U(string name) => entry.GetProperty(name).GetUInt32();
+            var fence = entry.GetProperty("IsFullSynchronizationFence").GetBoolean();
+            if (fence) fenced++;
+            var contract = new GuestAbiContract(
+                U("GprReadMask"), U("GprWriteMask") | U("GprClobberMask"), U("GprReturnMask"),
+                U("FprReadMask"), U("FprWriteMask"), U("FprReturnMask"),
+                (byte)U("CrReadMask"), (byte)U("CrWriteMask"),
+                entry.GetProperty("ReadsXer").GetBoolean(), entry.GetProperty("WritesXer").GetBoolean(),
+                true, true, true, true,
+                fence ? GuestCallBoundaryFlags.RequiresCompleteContext : GuestCallBoundaryFlags.None,
+                Array.Empty<uint>())
+            {
+                ReadsFpscrBeforeWrite = true, MayWriteFpscr = true,
+                GqrReadBeforeWriteMask = 0xFF, GqrPossibleWriteMask = 0xFF,
+                HidReadBeforeWriteMask = 0x07, HidPossibleWriteMask = 0x07,
+            };
+            var address = U("Address");
+            result[address] = result.TryGetValue(address, out var other) ? Union(other, contract) : contract;
+        }
+        report = $"{result.Count:N0} address(es) from {path} ({fenced:N0} entries with a fence)";
+        return result;
+    }
+
+    /// <summary>One line with every mask, for the record the tanda keeps (generated/mkw-ind-contrato.txt).</summary>
+    public static string Serialize(GuestAbiContract c) => string.Create(CultureInfo.InvariantCulture,
+        $"gprR={c.GprReadBeforeWriteMask:X8} gprW={c.GprPossibleWriteMask:X8} gprRet={c.GprReturnMask:X8} " +
+        $"fprR={c.FprReadBeforeWriteMask:X8} fprW={c.FprPossibleWriteMask:X8} fprRet={c.FprReturnMask:X8} " +
+        $"crR={c.CrReadBeforeWriteMask:X2} crW={c.CrPossibleWriteMask:X2} xer={(c.ReadsXerBeforeWrite ? 1 : 0)}{(c.MayWriteXer ? 1 : 0)} " +
+        $"ctr={(c.ReadsCtrBeforeWrite ? 1 : 0)}{(c.MayWriteCtr ? 1 : 0)} lr={(c.ReadsLrBeforeWrite ? 1 : 0)}{(c.MayWriteLr ? 1 : 0)} " +
+        $"fpscr={(c.ReadsFpscrBeforeWrite ? 1 : 0)}{(c.MayWriteFpscr ? 1 : 0)} gqrR={c.GqrReadBeforeWriteMask:X2} gqrW={c.GqrPossibleWriteMask:X2} " +
+        $"hidR={c.HidReadBeforeWriteMask:X2} hidW={c.HidPossibleWriteMask:X2} flags={(int)c.BoundaryFlags}");
+
+    public static string Describe(GuestAbiContract? c) => c is null
+        ? "full fence"
+        : string.Create(CultureInfo.InvariantCulture,
+            $"gprW={c.GprPossibleWriteMask:X8} fprW={c.FprPossibleWriteMask:X8} crW={c.CrPossibleWriteMask:X2} " +
+            $"gqrW={c.GqrPossibleWriteMask:X2} hidW={c.HidPossibleWriteMask:X2} flags={c.BoundaryFlags}");
+}
