diff --git a/runtime/include/mkw_motor.h b/runtime/include/mkw_motor.h
index d1fe8cb..f7f5df5 100644
--- a/runtime/include/mkw_motor.h
+++ b/runtime/include/mkw_motor.h
@@ -75,3 +75,16 @@
 #ifndef MKW_FIJA_BASE
 #define MKW_FIJA_BASE 0x00100000u
 #endif
+
+// MKW_MOTOR_W30 (W30, bitácora §257): «igual entre nosotros, no igual a la Wii». En la sala todas las consolas corren el
+// mismo .wasm, así que basta con que den lo mismo ENTRE ELLAS. Bits (apagado = 0, la Wii al último bit):
+//   1 = la FMA con las cuentas de wasm: float = (double)a*b + c bajado a float (el producto de dos float cabe exacto en
+//       un double: solo cambia en los empates del doble redondeo); double = a*b + c con dos redondeos (sin Dekker ni
+//       TwoSum). Los NaN se siguen reescribiendo como antes (los bits de un NaN de wasm no son deterministas).
+//   2 = las banderas del FPSCR que se calculaban en cada cuenta: sin el «NI» (pasar a cero los subnormales) en cada
+//       paso a float; queda el static_cast de siempre.
+//   4 = sin redondear el operando C a 25 bits en fmuls/fmadds (la rareza del multiplicador de la Wii).
+// Todas son operaciones IEEE de wasm (sin FMA de la máquina, sin modos de redondeo): el mismo resultado en x86 y ARM.
+#ifndef MKW_MOTOR_W30
+#define MKW_MOTOR_W30 7   // adoptado (§257): 0 = las cuentas de la Wii al último bit
+#endif
