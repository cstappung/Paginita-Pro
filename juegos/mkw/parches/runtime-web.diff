+    const uint64_t clave = (static_cast<uint64_t>(sitio + 1) << 32) | lr;
+    uint32_t h = static_cast<uint32_t>(clave * 0x9E3779B97F4A7C15ull >> 32);
+    uint32_t i = h & 511u;
