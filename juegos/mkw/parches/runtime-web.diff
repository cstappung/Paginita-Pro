+// MKW web — el reloj del azar de la carrera sincronizada (lockstep, bitácora §61). Las pocas funciones del juego
+// que sacan su azar del reloj del procesador (Random::__ct/Reset, los objetos, el temporizador: la lista está en
+// compilar-web.py, RELOJ_CARRERA) leen este en vez de mftb. Con g_mkwRelojFijo encendido es un contador: cada
+// lectura avanza kMkwRelojPaso desde un número que la página fija al preparar la carrera (semillas_nativo.cpp), así
+// todas las consolas de la sala sacan el mismo azar. Apagado (siempre, salvo en la sala con CPU) es el reloj normal.
+extern "C" {
+int g_mkwRelojFijo = 0;
+uint64_t g_mkwRelojValor = 0;
+unsigned g_mkwRelojGeneracion = 0;   // cambia en cada carrera (semillas_nativo.cpp): la hora de os_time.cpp empieza de cero
+}
+extern "C" uint32_t PPC_MftbCarrera()
+{
+    if (!g_mkwRelojFijo) return PPC_Mftb();
+    g_mkwRelojValor += 2000;                              // ~33 µs del reloj de la Wii por lectura
+    return static_cast<uint32_t>(g_mkwRelojValor);
+}
+
+// Lo que de verdad usan esas funciones (compilar-web.py): un reloj POR LUGAR. Con un solo contador para todas, una
+// lectura de más en cualquier parte (un efecto que arma su azar en una consola y no en otra) corría todos los números
+// siguientes: el sorteo del objeto de una caja salía distinto y la carrera se separaba (bitácora §62). Ahora el valor
+// sale solo de (cuadro de la carrera, función que lee, desde dónde la llamaron = lr, cuántas veces leyó ese mismo
+// lugar en este cuadro): base + cuadro·1012500 (un cuadro de 1/60 s del reloj de la Wii) + un corrimiento por lugar
+// + 7 por lectura. Sigue subiendo con el tiempo para cada lugar (los que miden cuánto pasó lo ven avanzar).
+namespace {
+struct LecturaReloj { uint64_t clave; uint64_t cuadro; uint32_t cuenta; };
+LecturaReloj g_lecturas[512];
+unsigned g_lecturasGen = ~0u;
+}
+extern "C" uint32_t PPC_MftbCarreraEn(uint32_t sitio, uint32_t lr)
+{
+    if (!g_mkwRelojFijo) return PPC_Mftb();
+    if (g_lecturasGen != g_mkwRelojGeneracion) {           // carrera nueva: tabla en cero
+        g_lecturasGen = g_mkwRelojGeneracion;
