+        LecturaReloj& l = g_lecturas[i];
+        if (l.clave == clave || l.clave == 0) {
+            if (l.clave == 0) l = LecturaReloj{clave, cuadro, 0};
+            if (l.cuadro != cuadro) { l.cuadro = cuadro; l.cuenta = 0; }
+            const uint32_t k = l.cuenta++;
+            return static_cast<uint32_t>(g_mkwRelojValor + cuadro * 1012500ull + (h & 255u) * 1000u + k * 7ull);
+        }
+    }
+    return static_cast<uint32_t>(g_mkwRelojValor + cuadro * 1012500ull + (h & 255u) * 1000u);   // tabla llena
+}
