+
+void ShutdownScheduler(Handle scheduler)
+{
+    auto* context = static_cast<Context*>(scheduler);
+    if (!context) {
+        return;
+    }
+    g_contexts.erase(context->id);
+    if (g_current == context) {
+        g_current = nullptr;
+    }
+    delete context;
+}
+
+Handle Create(std::size_t stackSize, Entry entry, void* argument)
+{
+    stackSize = (stackSize + 15) & ~static_cast<std::size_t>(15);
+    void* stack = std::aligned_alloc(16, stackSize);
+    if (!stack) {
+        return nullptr;
+    }
+    auto* context = new Context();
+    context->id = g_nextId++;
+    context->entry = entry;
+    context->argument = argument;
+    context->stack = stack;
+    g_contexts[context->id] = context;
+    const auto low = reinterpret_cast<uintptr_t>(stack);
+    mkw_hc_js_create(context->id, low + stackSize, low);
+    return context;
+}
+
+void Destroy(Handle context)
+{
+    auto* webContext = static_cast<Context*>(context);
+    if (!webContext) {
+        return;
+    }
+    // A suspended context is just a pending promise nobody can resolve any more once its
+    // entry is gone from the JS map; the garbage collector then frees its wasm stack.
+    mkw_hc_js_destroy(webContext->id);
+    g_contexts.erase(webContext->id);
+    std::free(webContext->stack);
+    delete webContext;
+}
+
+bool IsCurrent(Handle context)
+{
+    return context != nullptr && context == g_current;
+}
+
+void Switch(Handle target)
+{
+    auto* destination = static_cast<Context*>(target);
+    Context* source = g_current;
+    if (!destination || destination == source) {
+        return;
+    }
+
+    g_current = destination;
+    mkw_hc_js_switch(destination->id);
+    g_current = source;
+}
+
 #endif
 
 } // namespace HostContext
