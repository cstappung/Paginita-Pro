diff --git a/runtime/include/isa/ppc_isa_wasm_neon.h b/runtime/include/isa/ppc_isa_wasm_neon.h
new file mode 100644
index 0000000..834be87
--- /dev/null
+++ b/runtime/include/isa/ppc_isa_wasm_neon.h
@@ -0,0 +1,197 @@
+#pragma once
+// WebAssembly (Emscripten) port: the subset of <arm_neon.h> the ISA headers use, implemented with
+// clang's generic vector extension. wasm32 then reuses the AArch64 code paths unchanged, which is
+// the right model for it: like NEON, wasm arithmetic does not produce x86's NaN bits (wasm NaN
+// payloads are even nondeterministic), so it needs the same explicit NaN-lane resolution the
+// AArch64 branches already do (PpcResolveNanLanes*). wasm has no FP control register, so
+// flush-to-zero (FPSCR[NI]) is only tracked as state - see ppc_isa_fpenv.h.
+//
+// Only element-wise semantics matter here; whether clang lowers these to simd128 or to scalar
+// code is its choice. vfma_f32 is the one op that must not become an unfused multiply+add: it is
+// built from an exact single-rounding float FMA (MkwWasmFmaf).
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+typedef float float32x2_t __attribute__((vector_size(8)));
+typedef uint32_t uint32x2_t __attribute__((vector_size(8)));
+typedef double float64x1_t __attribute__((vector_size(8)));
+typedef uint64_t uint64x1_t __attribute__((vector_size(8)));
+
+// Exact fmaf for wasm (no hardware FMA): a float*float product fits exactly in a double, the sum's
+// rounding error is recovered with TwoSum and folded in as round-to-odd, and the final
+// double->float conversion then rounds once correctly (Boldo-Melquiond: 53 >= 24 + 2).
+// Verified bit-identical to musl's fmaf on 40M cases (banco/pruebas/fma).
+static inline __attribute__((always_inline)) float MkwWasmFmaf(float a, float b, float c) noexcept
+{
+    const double p = static_cast<double>(a) * static_cast<double>(b);
+    double s = p + static_cast<double>(c);
+    const double bb = s - p;
+    const double err = (p - (s - bb)) + (static_cast<double>(c) - bb);
+    if (err != 0.0 && __builtin_isfinite(s)) {
+        uint64_t u;
+        std::memcpy(&u, &s, sizeof(u));
+        if ((u & 1) == 0)
+            u += ((err > 0) == (s > 0)) ? 1 : static_cast<uint64_t>(-1);
+        std::memcpy(&s, &u, sizeof(u));
+    }
+    return static_cast<float>(s);
+}
+
+// MkwFma: what ppc_isa_float.h calls instead of std::fma (on other hosts it is std::fma). In wasm
+// std::fma is musl's software FMA: exact, but slow, and its NaN answers are not x86's (it returns a
+// signaling-NaN addend unquieted). This version is exact on the fast path above / below, and
+// rewrites every NaN result to what x86's FMA instruction gives: a NaN operand comes out quieted
+// with sign and payload kept (first NaN of a, b, c when several - with two or more NaN operands
+// even x86 depends on the operand order clang picked), and an invalid operation with no NaN input
+// (inf*0, inf-inf) gives x86's negative default NaN. That also hides wasm's nondeterministic NaN
+// bits, which differ between x86 and ARM clients.
+static inline __attribute__((always_inline)) uint64_t MkwWasmBits64(double x) noexcept { uint64_t u; std::memcpy(&u, &x, 8); return u; }
+static inline __attribute__((always_inline)) double MkwWasmFromBits64(uint64_t u) noexcept { double x; std::memcpy(&x, &u, 8); return x; }
+static inline __attribute__((always_inline)) uint32_t MkwWasmBits32(float x) noexcept { uint32_t u; std::memcpy(&u, &x, 4); return u; }
+static inline __attribute__((always_inline)) float MkwWasmFromBits32(uint32_t u) noexcept { float x; std::memcpy(&x, &u, 4); return x; }
+
+static inline __attribute__((noinline, cold)) double MkwWasmFmaNanSlow(double a, double b, double c) noexcept
+{
+    const double ops[3] = {a, b, c};
+    for (const double v : ops)
+        if (v != v)
+            return MkwWasmFromBits64(MkwWasmBits64(v) | 0x0008000000000000ull);
+    return MkwWasmFromBits64(0xFFF8000000000000ull);
+}
+static inline __attribute__((noinline, cold)) float MkwWasmFmafNanSlow(float a, float b, float c) noexcept
+{
+    const float ops[3] = {a, b, c};
+    for (const float v : ops)
+        if (v != v)
+            return MkwWasmFromBits32(MkwWasmBits32(v) | 0x00400000u);
+    return MkwWasmFromBits32(0xFFC00000u);
+}
+
+static inline __attribute__((always_inline)) float MkwFma(float a, float b, float c) noexcept
+{
+    const float r = MkwWasmFmaf(a, b, c);
+    if (r != r) [[unlikely]]
+        return MkwWasmFmafNanSlow(a, b, c);
+    return r;
+}
+
+// MkwFms(a, b, c) = a*b - c. Not the same as MkwFma(a, b, -c) for NaNs: x86 folds the negation
+// into one vfmsub instruction, so a NaN c comes out with its ORIGINAL sign; negating first would
+// flip it. (fmsub, fnmsub, ps_msub and the Subtract forms all go through here.)
+static inline __attribute__((always_inline)) float MkwFms(float a, float b, float c) noexcept
+{
+    const float r = MkwWasmFmaf(a, b, -c);
+    if (r != r) [[unlikely]]
+        return MkwWasmFmafNanSlow(a, b, c);
+    return r;
+}
+
+// Exact double FMA: Dekker TwoProduct + TwoSum + round-to-odd, one final rounding. Exponents that
+// could overflow/underflow the error terms (and 0/inf/NaN/subnormal multiplicands) go to musl.
+// Verified bit-identical to musl's fma on 50M cases including fabricated ties (banco/pruebas/fma).
+static inline __attribute__((always_inline)) double MkwWasmFmaRaw(double a, double b, double c) noexcept
+{
+    const uint32_t ea = (MkwWasmBits64(a) >> 52) & 0x7FF, eb = (MkwWasmBits64(b) >> 52) & 0x7FF,
+                   ec = (MkwWasmBits64(c) >> 52) & 0x7FF;
+    const int ep = static_cast<int>(ea) + static_cast<int>(eb) - 1023;
+    double r;
+    if (ea - 1u >= 1990u || eb - 1u >= 1990u || ep < 200 || ep > 1990 || ec > 1990) [[unlikely]] {
+        r = std::fma(a, b, c);  // musl: exact, slow, only for these rare exponents
+    } else {
+        const double K = 134217729.0;  // 2^27 + 1 (Dekker split)
+        double t = K * a;
+        const double ah = t - (t - a), al = a - ah;
+        t = K * b;
+        const double bh = t - (t - b), bl = b - bh;
+        const double ph = a * b;
+        const double pl = ((ah * bh - ph) + ah * bl + al * bh) + al * bl;  // a*b = ph + pl
+        const double sh = ph + c;
+        double bb = sh - ph;
+        const double sl = (ph - (sh - bb)) + (c - bb);                     // ph + c = sh + sl
+        double vh = sl + pl;
+        bb = vh - sl;
+        const double vl = (sl - (vh - bb)) + (pl - bb);                    // sl + pl = vh + vl
+        if (vl != 0.0) {                                                   // vh := round-to-odd(vh + vl)
+            uint64_t u = MkwWasmBits64(vh);
+            if ((u & 1) == 0)
+                u += ((vl > 0) == (vh > 0)) ? 1 : static_cast<uint64_t>(-1);
+            vh = MkwWasmFromBits64(u);
+        }
+        r = sh + vh;
+    }
+    return r;
+}
+
+static inline __attribute__((always_inline)) double MkwFma(double a, double b, double c) noexcept
+{
+    const double r = MkwWasmFmaRaw(a, b, c);
+    if (r != r) [[unlikely]]
+        return MkwWasmFmaNanSlow(a, b, c);
+    return r;
+}
+
+static inline __attribute__((always_inline)) double MkwFms(double a, double b, double c) noexcept
+{
+    const double r = MkwWasmFmaRaw(a, b, -c);
+    if (r != r) [[unlikely]]
+        return MkwWasmFmaNanSlow(a, b, c);
+    return r;
+}
+
+#define MKW_WASM_NEON static inline __attribute__((always_inline))
+
+// Reinterprets (bit casts between same-size vectors).
+MKW_WASM_NEON float32x2_t vreinterpret_f32_u32(uint32x2_t v) { return reinterpret_cast<float32x2_t>(v); }
+MKW_WASM_NEON uint32x2_t vreinterpret_u32_f32(float32x2_t v) { return reinterpret_cast<uint32x2_t>(v); }
+MKW_WASM_NEON float32x2_t vreinterpret_f32_f64(float64x1_t v) { return reinterpret_cast<float32x2_t>(v); }
+MKW_WASM_NEON float64x1_t vreinterpret_f64_f32(float32x2_t v) { return reinterpret_cast<float64x1_t>(v); }
+MKW_WASM_NEON uint64x1_t vreinterpret_u64_f64(float64x1_t v) { return reinterpret_cast<uint64x1_t>(v); }
+MKW_WASM_NEON float64x1_t vreinterpret_f64_u64(uint64x1_t v) { return reinterpret_cast<float64x1_t>(v); }
+MKW_WASM_NEON uint64x1_t vreinterpret_u64_u32(uint32x2_t v) { return reinterpret_cast<uint64x1_t>(v); }
+
+// Broadcasts and lane access.
+MKW_WASM_NEON uint32x2_t vdup_n_u32(uint32_t x) { return uint32x2_t{x, x}; }
+MKW_WASM_NEON float32x2_t vdup_n_f32(float x) { return float32x2_t{x, x}; }
+MKW_WASM_NEON float64x1_t vdup_n_f64(double x) { return float64x1_t{x}; }
+MKW_WASM_NEON uint64x1_t vdup_n_u64(uint64_t x) { return uint64x1_t{x}; }
+#define vdup_lane_f32(v, lane) (float32x2_t{(v)[lane], (v)[lane]})
+#define vget_lane_f32(v, lane) ((float)(v)[lane])
+#define vget_lane_f64(v, lane) ((double)(v)[lane])
+#define vget_lane_u64(v, lane) ((uint64_t)(v)[lane])
+MKW_WASM_NEON float32x2_t MkwWasmSetLaneF32(float x, float32x2_t v, int lane) { v[lane] = x; return v; }
+#define vset_lane_f32(x, v, lane) MkwWasmSetLaneF32((x), (v), (lane))
+
+// Comparisons: all-ones lane where true (NEON and the vector extension agree on this).
+MKW_WASM_NEON uint32x2_t vceq_f32(float32x2_t a, float32x2_t b) { return reinterpret_cast<uint32x2_t>(a == b); }
+MKW_WASM_NEON uint64x1_t vclt_f64(float64x1_t a, float64x1_t b) { return reinterpret_cast<uint64x1_t>(a < b); }
+
+// Bitwise.
+MKW_WASM_NEON uint32x2_t vmvn_u32(uint32x2_t a) { return ~a; }
+MKW_WASM_NEON uint32x2_t veor_u32(uint32x2_t a, uint32x2_t b) { return a ^ b; }
+MKW_WASM_NEON uint32x2_t vorr_u32(uint32x2_t a, uint32x2_t b) { return a | b; }
+MKW_WASM_NEON uint64x1_t vand_u64(uint64x1_t a, uint64x1_t b) { return a & b; }
+MKW_WASM_NEON uint64x1_t vbic_u64(uint64x1_t a, uint64x1_t b) { return a & ~b; }
+MKW_WASM_NEON uint64x1_t vbsl_u64(uint64x1_t m, uint64x1_t a, uint64x1_t b) { return (m & a) | (~m & b); }
+MKW_WASM_NEON float32x2_t vbsl_f32(uint32x2_t m, float32x2_t a, float32x2_t b)
+{
+    return reinterpret_cast<float32x2_t>((m & reinterpret_cast<uint32x2_t>(a)) | (~m & reinterpret_cast<uint32x2_t>(b)));
+}
+
+// Arithmetic. vneg flips the sign bit unconditionally (NaN included), like NEON's FNEG.
+MKW_WASM_NEON float32x2_t vneg_f32(float32x2_t a)
+{
+    return reinterpret_cast<float32x2_t>(reinterpret_cast<uint32x2_t>(a) ^ uint32x2_t{0x80000000u, 0x80000000u});
+}
+MKW_WASM_NEON float32x2_t vadd_f32(float32x2_t a, float32x2_t b) { return a + b; }
+MKW_WASM_NEON float32x2_t vsub_f32(float32x2_t a, float32x2_t b) { return a - b; }
+MKW_WASM_NEON float32x2_t vmul_f32(float32x2_t a, float32x2_t b) { return a * b; }
+MKW_WASM_NEON float32x2_t vdiv_f32(float32x2_t a, float32x2_t b) { return a / b; }
+// vfma_f32(acc, a, b) = acc + a*b per lane, one rounding.
+MKW_WASM_NEON float32x2_t vfma_f32(float32x2_t acc, float32x2_t a, float32x2_t b)
+{
+    return float32x2_t{MkwWasmFmaf(a[0], b[0], acc[0]), MkwWasmFmaf(a[1], b[1], acc[1])};
+}
+
+#undef MKW_WASM_NEON
diff --git a/runtime/src/guest_flat_memory_wasm.cpp b/runtime/src/guest_flat_memory_wasm.cpp
new file mode 100644
index 0000000..57cb93d
--- /dev/null
+++ b/runtime/src/guest_flat_memory_wasm.cpp
@@ -0,0 +1,128 @@
+// WebAssembly backend for the guest memory regions.
+//
+// wasm has one linear memory (at most 4 GiB, shared with the runtime itself) and no page protection, so
+// there is no flat guest view: RequiresCheckedAccess() is a compile-time true (guest_flat_memory.h) and
+// every access goes through Memory's page table. This module therefore only has to hand out host
+// storage per region. Mirrors share one store, exactly like the macOS backend this follows
+// (guest_flat_memory_macos.cpp): MEM1 at 0x00000000/0x80000000/0xC0000000 and MEM2 at
+// 0x10000000/0x90000000/0xD0000000 must alias, other regions own their bytes. The protection hooks are
+// no-ops; deferred EFB reads and executable-write guards are enforced by the page table's readable /
+// writable bias tables instead.
+#if defined(__EMSCRIPTEN__)
+
+#include "guest_flat_memory.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+namespace GuestFlat {
+namespace {
+
+struct Store {
+    Backing kind = Backing::Owned;
+    uint32_t owned = 0;
+    uint64_t size = 0;
+    uint8_t* host = nullptr;
+};
+
+struct Mapping {
+    uint32_t base = 0;
+    uint64_t size = 0;
+    uint8_t* host = nullptr;
+};
+
+std::vector<Store> g_stores;
+std::vector<Mapping> g_mappings;
+std::vector<RegionRequest> g_layout;
+bool g_active = false;
+
+inline uint64_t RoundUp(uint64_t value, uint64_t align) {
+    return (value + align - 1) & ~(align - 1);
+}
+
+uint64_t Offset(const RegionRequest& r) {
+    if (r.backing == Backing::Mem1) return r.base & 0x1fffffffu;
+    if (r.backing == Backing::Mem2) return (r.base & 0x1fffffffu) - 0x10000000u;
+    return 0;
+}
+
+bool Same(const std::vector<RegionRequest>& a, const std::vector<RegionRequest>& b) {
+    return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(),
+        [](const auto& x, const auto& y) { return x.base == y.base && x.size == y.size && x.backing == y.backing; });
+}
+
+} // namespace
+
+bool IsActive() { return g_active; }
+
+void Initialize(const std::vector<RegionRequest>& regions) {
+    if (g_active) {
+        if (!Same(g_layout, regions))
+            throw std::runtime_error("guest memory layout cannot be remapped");
+        return;
+    }
+
+    std::vector<Store> stores;
+    for (const auto& r : regions) {
+        if (!r.size) continue;
+        if (r.size > kGuestSpaceSize - r.base)
+            throw std::runtime_error("invalid guest memory region");
+        const uint32_t owned = r.backing == Backing::Owned ? r.base : 0;
+        auto it = std::find_if(stores.begin(), stores.end(), [&](const Store& s) {
+            return s.kind == r.backing && s.owned == owned;
+        });
+        const uint64_t need = RoundUp(Offset(r) + r.size, kGuestPageSize);
+        if (it == stores.end()) {
+            stores.push_back({r.backing, owned, need, nullptr});
+        } else {
+            it->size = std::max(it->size, need);
+        }
+    }
+
+    for (auto& s : stores) {
+        // Zero-filled like fresh pages: the game's BSS relies on it.
+        void* host = std::aligned_alloc(kGuestPageSize, static_cast<size_t>(s.size));
+        if (!host) {
+            for (auto& done : stores) std::free(done.host);
+            throw std::runtime_error("unable to allocate guest memory in the wasm heap");
+        }
+        std::memset(host, 0, static_cast<size_t>(s.size));
+        s.host = static_cast<uint8_t*>(host);
+    }
+
+    for (const auto& r : regions) {
+        if (!r.size) continue;
+        const uint32_t owned = r.backing == Backing::Owned ? r.base : 0;
+        const auto& s = *std::find_if(stores.begin(), stores.end(), [&](const Store& x) {
+            return x.kind == r.backing && x.owned == owned;
+        });
+        g_mappings.push_back({r.base, r.size, s.host + Offset(r)});
+    }
+
+    g_layout = regions;
+    g_stores = std::move(stores);
+    g_active = true;
+}
+
+uint8_t* HostPointer(uint32_t a) {
+    for (const auto& m : g_mappings) {
+        if (a >= m.base && uint64_t(a - m.base) < m.size) {
+            return m.host + (a - m.base);
+        }
+    }
+    return nullptr;
+}
+
+void ProtectDeferredRange(uint32_t, size_t) {}
+void UnprotectDeferredRange(uint32_t, size_t) {}
+void RegisterExecutableRange(uint32_t, uint32_t) {}
+FaultCounters Counters() { return {}; }
+void LogFaultSummary() noexcept {}
+bool HandleAccessViolation(void*, bool) noexcept { return false; }
+
+} // namespace GuestFlat
