+// ---- MKW RETRO (G3 y H12 del plan de rendimiento, bitácora §181): lo que no cambió no se vuelve a subir ----
+// Antes, cada lote copiaba a la tarjeta todos los vértices, índices y arreglos de vértices (storage) que usó, aunque la
+// pista y los karts traen los mismos bytes cuadro tras cuadro. Ahora cada uno de los tres búferes de la tarjeta tiene,
+// después de su parte de siempre ([0, Size)), un ANILLO persistente: lo que ya se subió queda ahí y el dibujo apunta a
+// esa copia; solo lo nuevo se escribe (en el anillo, una llamada por lote). Cómo se reconoce lo mismo:
+// - los arreglos (storage): por su dirección y tamaño, y la generación de escrituras del juego sobre esa memoria
+//   (guest_write_generation: el runtime cuenta cada DCFlushRange/DCStoreRange; las texturas ya lo usan); si la memoria
+//   no está vigilada, por la huella xxh3 del contenido;
+// - los vértices e índices de cada dibujo (que salen de las listas de dibujo): por la huella xxh3 de sus bytes, al
+//   cerrar el lote, cuando los dibujos juntados ya están completos. Mover los vértices obliga a corregir el primer número
+//   del bloque de uniformes del dibujo (vtx_start), que todavía no se subió.
+// Seguridad del anillo: una entrada sirve mientras la cabeza no dio la vuelta encima (head <= pos + size); si quedó a
+// más de media vuelta se vuelve a escribir (así lo que se usa nunca está por ser pisado); un lote escribe a lo más 1/4
+// de vuelta y una entrada mide a lo más 1/8: lo que se usó en el lote no se pisa dentro del mismo lote. Lo que lotes ya
+// enviados leen de una zona que se reescribe lo protege el orden de la fila (WriteBuffer va después de lo ya enviado).
+// MKW_ANILLO=0 (la página con ?anillo=0) = como antes; MKW_ANILLO=2 (?anillo=verifica) = además, cada acierto por
+// generación se compara con la huella del contenido (cuenta las diferencias: tienen que ser 0).
+
+static inline uint64_t anillo_huella(const void* data, size_t len) {
+  return xxh3_hash_s(data, len, static_cast<HashType>(len));
+}
+static inline bool anillo_vale(const Anillo& a, const EntradaAnillo& e, uint64_t len) {
+  return e.pos != UINT64_MAX && e.len == len && a.head <= e.pos + a.size && a.head - e.pos <= a.size / 2;
+}
+static inline Range anillo_rango(const Anillo& a, const EntradaAnillo& e) {
+  return {static_cast<uint32_t>(a.base + e.pos % a.size), static_cast<uint32_t>(e.len)};
+}
+static void anillo_subir(Anillo& a) {
+  if (a.run.empty()) return;
+  g_queue.WriteBuffer(*a.gpu, a.base + a.runStart % a.size, a.run.data(), a.run.size());
+  a.run.clear();
+  a.runStart = a.head;
+}
+// Lugar para len bytes (len múltiplo de 4); copia data (y ceros hasta len). UINT64_MAX = no entra en este lote.
+static uint64_t anillo_poner(Anillo& a, const void* data, size_t bytes, uint64_t len) {
+  if (len > a.size / 8) return UINT64_MAX;
+  uint64_t pos = AURORA_ALIGN(a.head, a.align);
+  if (pos % a.size + len > a.size) pos = (pos / a.size + 1) * a.size;   // nunca partido en el borde: a la vuelta siguiente
+  if (pos + len - a.batchStart > a.size / 4) return UINT64_MAX;
+  if (!a.run.empty() && pos / a.size != a.runStart / a.size) anillo_subir(a);   // cambió de vuelta: subir lo anterior
+  if (a.run.empty()) a.runStart = pos;
+  a.run.resize(pos - a.runStart, 0);       // el hueco de alineación, en ceros
+  const auto* p = static_cast<const u8*>(data);
+  a.run.insert(a.run.end(), p, p + bytes);
+  a.run.resize(pos + len - a.runStart, 0);
+  a.head = pos + len;
+  return pos;
+}
+
+Range push_storage_cacheable(const uint8_t* data, size_t length) {
+  if (g_anilloModo == 0 || data == nullptr || length == 0) return push_storage(data, length);
+  const uint64_t len = AURORA_ALIGN(length, g_anStorage.align);
+  const uint64_t key = (static_cast<uint64_t>(reinterpret_cast<uintptr_t>(data)) << 20) ^ length;
+  const uint64_t gen = guest_write_generation(data, length);
+  auto& e = g_anArreglos[key];
+  bool acierto = e.ptr == data && e.bytes == length && anillo_vale(g_anStorage, e, len);
+  uint64_t huella = 0;
+  if (acierto) {
+    if (gen != kGuestWriteUntracked && gen == e.gen) {
+      if (g_anilloModo == 2) {
+        huella = anillo_huella(data, length);
+        if (huella != e.hash) { ++g_anCuenta[6]; acierto = false; }
+      }
+    } else {
+      huella = anillo_huella(data, length);
+      acierto = huella == e.hash;
+      if (acierto) e.gen = gen;   // la escritura no cambió estos bytes
+      ++g_anCuenta[9];
+    }
+  }
+  if (acierto) {
+    g_anCuenta[4] += len;
+    return anillo_rango(g_anStorage, e);
+  }
+  const uint64_t pos = anillo_poner(g_anStorage, data, length, len);
+  if (pos == UINT64_MAX) {
+    ++g_anCuenta[8];
+    return push_storage(data, length);
+  }
+  if (huella == 0) huella = anillo_huella(data, length);
+  e = EntradaAnillo{.pos = pos, .len = len, .gen = gen, .hash = huella, .ptr = data, .bytes = length};
+  g_anCuenta[5] += len;
+  return anillo_rango(g_anStorage, e);
+}
+
+// Un rango del lote (vértices o índices de un dibujo) pasa al anillo: el mismo contenido ya subido, o se escribe ahora.
+static bool anillo_reubicar(Anillo& a, absl::flat_hash_map<uint64_t, EntradaAnillo>& mapa, ByteBuffer& buf,
+                            Range& r, uint64_t* reusado, uint64_t* escrito) {
+  if (r.offset >= a.base) return true;                       // ya está en el anillo
+  if (uint64_t(r.offset) + r.size > buf.size()) return false;
+  const u8* data = buf.data() + r.offset;
+  const uint64_t len = AURORA_ALIGN(uint64_t(r.size), 4);
+  const uint64_t huella = anillo_huella(data, r.size);
+  auto& e = mapa[huella];
+  if (e.bytes == r.size && anillo_vale(a, e, len)) {
+    *reusado += len;
+  } else {
+    const uint64_t pos = anillo_poner(a, data, r.size, len);
+    if (pos == UINT64_MAX) return false;
+    e = EntradaAnillo{.pos = pos, .len = len, .hash = huella, .bytes = r.size};
+    *escrito += len;
+  }
+  r.offset = static_cast<uint32_t>(a.base + e.pos % a.size);
+  return true;
