+static void web_leer_lista(const char* ruta, uint32_t& aceptadas, uint32_t& descartadas) {
+  std::FILE* f = std::fopen(ruta, "rb");
+  if (f == nullptr) {
+    return;
+  }
+  std::vector<uint8_t> d;
+  uint8_t buf[65536];
+  size_t n;
+  while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) {
+    d.insert(d.end(), buf, buf + n);
+  }
+  std::fclose(f);
+  const auto u32 = [&](size_t o) {
+    uint32_t v;
+    std::memcpy(&v, d.data() + o, 4);
+    return v;
+  };
+  if (d.size() < 12 || std::memcmp(d.data(), WebMagia, 8) != 0) {
+    std::printf("[pipelines] %s no es una lista de pipelines; se ignora\n", ruta);
+    return;
+  }
+  const uint32_t cantidad = u32(8);
+  size_t o = 12;
+  for (uint32_t i = 0; i < cantidad; ++i) {
