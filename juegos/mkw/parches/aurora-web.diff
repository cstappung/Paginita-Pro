+static void web_leer_lista(const char* ruta, uint32_t& aceptadas, uint32_t& descartadas) {
+  std::FILE* f = std::fopen(ruta, "rb");
+  if (f == nullptr) {
+    return;
+  }
+  std::vector<uint8_t> d;
+  uint8_t buf[65536];
+  size_t n;
+  while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) {
+    d.insert(d.end(), buf, buf + n);
+  }
+  std::fclose(f);
+  const auto u32 = [&](size_t o) {
+    uint32_t v;
+    std::memcpy(&v, d.data() + o, 4);
+    return v;
+  };
+  const bool v2 = d.size() >= 12 && std::memcmp(d.data(), WebMagia2, 8) == 0;   // C2 (§174): con etiqueta y visita
+  if (d.size() < 12 || (!v2 && std::memcmp(d.data(), WebMagia, 8) != 0)) {
+    std::printf("[pipelines] %s no es una lista de pipelines; se ignora\n", ruta);
+    return;
+  }
+  const uint32_t cantidad = u32(8);
+  const size_t cabeza = v2 ? 24 : 16;
+  size_t o = 12;
+  for (uint32_t i = 0; i < cantidad; ++i) {
+    if (o + cabeza > d.size()) {
+      break;
+    }
+    const uint32_t tipo = u32(o), version = u32(o + 4), primerCuadro = u32(o + 8);
+    const uint32_t etiqueta = v2 ? u32(o + 12) : WebSinEtiqueta, visita = v2 ? u32(o + 16) : 0;
+    const uint32_t tam = u32(o + cabeza - 4);
+    o += cabeza;
+    if (o + tam > d.size()) {
+      break;
+    }
+    bool ok = false;
+    if (tipo == underlying(ShaderType::GX)) {
+      ok = web_precalentar_una<gx::PipelineConfig>(d.data() + o, tam, primerCuadro, gx::create_pipeline,
+                                                   gx::GXPipelineConfigVersion, ShaderType::GX, etiqueta, visita);
+    } else if (tipo == underlying(ShaderType::Clear)) {
+      ok = web_precalentar_una<clear::PipelineConfig>(d.data() + o, tam, primerCuadro, clear::create_pipeline,
+                                                      clear::ClearPipelineConfigVersion, ShaderType::Clear, etiqueta, visita);
+    }
+    (ok ? aceptadas : descartadas)++;
+    o += tam;
+  }
+}
