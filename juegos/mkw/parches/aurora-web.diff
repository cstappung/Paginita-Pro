+        if (transparente) {
+          return false;
+        }
+        dst[0] = static_cast<uint8_t>(c0 & 0xFF);
+        dst[1] = static_cast<uint8_t>(c0 >> 8);
+        dst[2] = static_cast<uint8_t>(c1 & 0xFF);
+        dst[3] = static_cast<uint8_t>(c1 >> 8);
+        std::memcpy(dst + 4, filas, 4);
+        dst += 8;
+      }
+    }
+    base += tamMip;
+  }
+  return true;
+}
 } // namespace aurora::gfx
