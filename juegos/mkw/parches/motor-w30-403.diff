 // Byte-wise copy into guest RAM plus the DMA notification the GX caches need.
 static void CopyToGuestAsDma(uint32_t dest, const uint8_t* data, size_t size) {
+#if MKW_MOTOR_PR403 & 4
+    // PR #403 de WiiCompiled (§277): donde Write8 es una escritura simple (la ventana fija de H6, o una página de 1 MiB
+    // entera escribible), los bytes van de una vez con memcpy; en cualquier otra página, Write8 byte a byte como antes.
+    size_t done = 0;
+    while (done < size) {
+        const uint32_t address = dest + static_cast<uint32_t>(done);
+        const size_t rest = size - done;
+#if MKW_MOTOR_FIJA
+        if (rest <= MemoryInline::kFijaLargo && MemoryInline::FijaDentro(address, static_cast<uint32_t>(rest))) {
+#ifdef MKW_SUCIAS
+            mkw_sucias_rango(address, static_cast<uint32_t>(rest));
+#endif
+            std::memcpy(MemoryInline::FijaPtr(address), data + done, rest);
+            break;
+        }
+#endif
+        const size_t pageLeft = MemoryInline::kPageSize - (address & MemoryInline::kPageMask);
+        const size_t chunk = std::min(rest, pageLeft);
+        if (const uintptr_t bias = MemoryInline::g_fullWritablePageBias[address >> MemoryInline::kPageShift];
+            bias != 0) {
+#ifdef MKW_SUCIAS
+            mkw_sucias_rango(address, static_cast<uint32_t>(chunk));
+#endif
+            std::memcpy(reinterpret_cast<uint8_t*>((bias - 1u) + address), data + done, chunk);
+        } else {
+            for (size_t i = 0; i < chunk; ++i) {
+                Memory::Write8(address + static_cast<uint32_t>(i), data[done + i]);
+            }
+        }
+        done += chunk;
+    }
