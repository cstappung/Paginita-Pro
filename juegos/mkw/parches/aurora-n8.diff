 }
 void aurora_set_present_schedule(uint64_t baseNanos, uint64_t intervalNanos) {
+#if defined(__EMSCRIPTEN__) && defined(AURORA_ENABLE_GX)
+  // N8 (§219): a drawn frame stands for two retraces, so the runtime's «more than one retrace since the last present»
+  // is the normal cadence, not a late frame (with it aurora dropped the slots: «60/60 frames overran»). Here the frame
+  // is late only if more than TWO retraces passed between the anchors of two drawn frames.
+  static uint64_t s_anclaAnterior = 0;
+  if (aurora::g_mkwN8 && baseNanos && intervalNanos) {
+    const bool paced = s_anclaAnterior == 0 || baseNanos <= s_anclaAnterior ||
+                       baseNanos - s_anclaAnterior <= 2 * intervalNanos + intervalNanos / 2;
+    aurora::gx::report_producer_paced(paced);
+  }
+  s_anclaAnterior = baseNanos;
+#endif
   aurora::g_presentScheduleBaseNanos.store(baseNanos, std::memory_order_release);
   aurora::g_presentScheduleIntervalNanos.store(intervalNanos, std::memory_order_release);
 }
+#ifdef __EMSCRIPTEN__
+// MKW RETRO (§219, N8): 1 = the game draws one frame out of two (interpolated image now, the real one a retrace later)
+extern "C" void aurora_mkw_n8(int on) {
+  aurora::g_mkwN8 = on;
+  if (!on) aurora::g_mkwN8Pendiente.reset();
+}
+// the real image held from the drawn frame. donde = 0: the skipped frame, at its copy: it waits (yielding) until its
+// deadline, but only if that deadline falls before the next drawn frame's retrace (+3 ms): waiting longer would push
+// the next drawn frame back (a drawn frame longer than a retrace, §219). donde = 1: the next drawn frame, when its draw
+// starts (after its logic): what is still pending goes out at once, without waiting. 1 = presented now
+extern "C" int aurora_mkw_presentar_pendiente(int donde) {
+  if (!aurora::g_mkwN8Pendiente) return 0;
+  auto& pendiente = *aurora::g_mkwN8Pendiente;
+  if (donde == 0) {
+    const uint64_t base = aurora::g_presentScheduleBaseNanos.load(std::memory_order_acquire);
+    const uint64_t intervalo = aurora::g_presentScheduleIntervalNanos.load(std::memory_order_acquire);
+    if (base && intervalo) {
+      const aurora::PresentClock::time_point limite{std::chrono::nanoseconds{base + intervalo + 3'000'000}};
+      if (pendiente.presentAt > limite) return 0;
+    }
+  } else if (pendiente.presentAt > aurora::PresentClock::now()) {
+    pendiente.presentAt = aurora::PresentClock::now();
+  }
+  const auto job = std::move(pendiente);
+  aurora::g_mkwN8Pendiente.reset();
+  aurora::present_presentation_job(job);
+  ++aurora::g_mkwN8Cuenta[donde == 0 ? 1 : 4];
+  aurora::g_mkwN8EsperaMs +=
+      std::chrono::duration<double, std::milli>(aurora::PresentClock::now() - aurora::g_mkwN8Guardada).count();
+  return 1;
+}
+extern "C" uint32_t aurora_mkw_n8_cuenta(int i) { return i >= 0 && i < 5 ? aurora::g_mkwN8Cuenta[i] : 0; }
+extern "C" double aurora_mkw_n8_espera_ms() { return aurora::g_mkwN8EsperaMs; }
+#endif
 void aurora_report_producer_paced(bool paced) {
 #ifdef AURORA_ENABLE_GX
+#ifdef __EMSCRIPTEN__
+  if (aurora::g_mkwN8) return;   // (N8: aurora_set_present_schedule decides, right after this)
+#endif
   aurora::gx::report_producer_paced(paced);
 #else
   (void)paced;
