+// P5 (E6, bitácora §232): ONE call into the page per push. It hands over the piece and, on the way back, brings the
+// worklet queue's level (the return value) and its target (written at *objetivo): the rate trim that follows the push
+// reads those two numbers instead of calling the page twice more (3 crossings -> 1, ~330 pushes a second).
+EM_JS(double, mkw_web_sonido_entregar, (const float* datos, int cuadros, int canales, double* objetivo), {
+    const s = Module.mkwSonido;
+    s.entregar(HEAPF32.subarray(datos >> 2, (datos >> 2) + cuadros * canales));
+    HEAPF64[objetivo >> 3] = s.objetivoMs();
+    return s.nivelMs();
 });
