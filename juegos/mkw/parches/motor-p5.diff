-EM_JS(double, mkw_web_sonido_objetivo, (), { return Module.mkwSonido.objetivoMs(); });
 
 namespace {
+// P5: what the last push brought back from the page (the worklet queue's level, -1 = not playing, and its target)
+double g_webNivelMs = -1.0;
+double g_webObjetivoMs = 60.0;
