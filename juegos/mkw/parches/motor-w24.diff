 #include <iostream>
 #include <mutex>
 #include <unordered_map>
@@ -390,10 +391,33 @@ void ReportUnparkableSleep(uint32_t queuePtr, uint32_t thread)
 
 // OSSleepThread (0x801aa9b8)
 // Puts the current thread to sleep on a specified wait queue.
+#ifdef MKW_SUCIAS
+// MKW RETRO, W24 (bitácora §227): el teléfono que solo dibuja corre su propio bucle (pegar la caja y dibujar) sin dejar
+// correr a ningún otro hilo. Si en ese modo el hilo principal se duerme, se anota dónde (la cola y la cadena de llamadas
+// de la pila de la Wii: [r1] = el marco de antes, [marco + 4] = de dónde se llamó), para saber qué espera.
+extern "C" uint32_t g_mkwW24Solo;
+extern "C" uint32_t g_mkwW24Dormidas = 0;
+static void mkwW24AnotarSueno(CpuContext* cpu, uint32_t cola) {
+    if (!g_mkwW24Solo || ++g_mkwW24Dormidas > 24) return;
+    std::printf("[w24] el hilo principal se duerme en la cola %08x, lr %08x, pila:", cola, cpu->lr);
+    uint32_t sp = cpu->gpr[1];
+    for (int i = 0; i < 16 && sp && ::Memory::Contains(sp, 8); i++) {
+        const uint32_t atras = ::Memory::Read32(sp);
+        if (!atras || !::Memory::Contains(atras, 8)) break;
+        std::printf(" %08x", ::Memory::Read32(atras + 4));
+        sp = atras;
+    }
+    std::printf("
+");
+}
+#endif
 extern "C" void OSSleepThread_HLE_801aa9b8(CpuContext* ctx)
 {
     CpuContext* cpu = ctx ? ctx : &GetPersistentCpuContext();
     const uint32_t queuePtr = cpu->gpr[3];
+#ifdef MKW_SUCIAS
+    mkwW24AnotarSueno(cpu, queuePtr);
+#endif
     
     if (queuePtr == 0) {
         RT_LOG(RT_TAG_OS) << "OSSleepThread: null queue pointer!" << std::endl;
