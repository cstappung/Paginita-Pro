          "cartas": {
            "$i": { ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().matches(/^([A-Za-z0-9]{6,40}~)?[-_A-Za-z0-9]{8,24}[.][0-4]$/)" }
          },
          "at": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },


    "userProjects": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
