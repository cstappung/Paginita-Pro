          ".validate": "$id.matches(/^[-_A-Za-z0-9]{8,24}$/) && newData.hasChildren(['de', 'para', 'dar', 'at'])",
          "de": { ".validate": "newData.isString()" },
          "para": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6,40}$/) && newData.val() !== newData.parent().child('de').val()" },
          "dar": {
            "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6,40}~[-_A-Za-z0-9]{8,24}[.][0-4]$/)" }
          },
          "pedir": {
            "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6,40}~[-_A-Za-z0-9]{8,24}[.][0-4]$/)" }
          },
          "at": { ".validate": "newData.val() === now" },
          "ok": {
            ".write": "auth != null && !data.exists() && newData.exists() && data.parent().child('para').val() === auth.uid && !data.parent().child('x').exists()",
            ".validate": "newData.val() === now && newData.parent().child('para').val() === auth.uid"
          },
          "x": {
            ".write": "auth != null && !data.exists() && newData.exists() && (data.parent().child('de').val() === auth.uid || data.parent().child('para').val() === auth.uid) && !data.parent().child('ok').exists()",
            ".validate": "newData.val() === now"
          },
          "$otro": { ".validate": false }
        }
      }
    },

    "clubJugadas": {
      ".read": "auth != null",
      "$uid": {
        "$juego": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "$juego.matches(/^(minas|snake|tetrisclub|sortem|bbtan|sopa|electro|frontera|sudoku)$/) && newData.hasChildren(['dia', 'hoy', 'total', 'at']) && newData.child('at').val() === now && newData.child('dia').val() * 86400000 + 10800000 <= now && now < newData.child('dia').val() * 86400000 + 100800000 && newData.child('hoy').val() <= ($juego === 'bbtan' ? 10 : 15) && (data.exists() ? (newData.child('total').val() === data.child('total').val() + 1 && (newData.child('dia').val() === data.child('dia').val() ? newData.child('hoy').val() === data.child('hoy').val() + 1 : (newData.child('dia').val() > data.child('dia').val() && newData.child('hoy').val() === 1))) : (newData.child('total').val() === 1 && newData.child('hoy').val() === 1))",
          "dia": { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
          "hoy": { ".validate": "newData.isNumber()" },
          "total": { ".validate": "newData.isNumber()" },
          "at": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        }
      }
    },

    "tienda": {
      ".read": "auth != null",
      "$uid": {
        "$item": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "$item.matches(/^(cometa|vortice|sakura|plasma|mariposas|estrellas|olas|lluvia|fuegos|holo)$/) && newData.hasChildren(['at', 'p']) && newData.child('at').val() === now && newData.child('p').val() === 5000",
          "at": { ".validate": "newData.isNumber()" },
          "p": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        }
      }
    },
    "podios": {
      ".read": "auth != null",
      "$uid": {
        "$p": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "$p.matches(/^[-_A-Za-z0-9]{6,80}$/) && newData.hasChildren(['c', 'p', 'q', 'at']) && newData.child('at').val() === now && root.child('soloRanks').child(newData.child('c').val()).child($uid).child('partida').val() === $p",
          "c": { ".validate": "newData.isString() && newData.val().matches(/^(club-[a-z0-9-]+|yemas-zombis-[a-z]+)$/)" },
          "p": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2 || newData.val() === 3)" },
          "q": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6,40}$/) && newData.val() !== $uid" },
          "at": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        }
      }
    },

    "enCurso": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$pid": {
        ".write": "auth != null && ((newData.exists() && root.child('partidas').child($pid).child('jugadores').child(auth.uid).exists() && !root.child('partidas').child($pid).child('fin').exists()) || (!newData.exists() && (!root.child('partidas').child($pid).exists() || root.child('partidas').child($pid).child('fin').exists() || root.child('partidas').child($pid).child('jugadores').child(auth.uid).exists())))",
        ".validate": "newData.hasChildren(['juego', 'nombres', 'n', 'at'])",
        "juego": {".validate": "newData.isString() && newData.val().length <= 20"},
        "nombres": {".validate": "newData.isString() && newData.val().length <= 200"},
        "n": {".validate": "newData.isNumber()"},
        "at": {".validate": "newData.val() === now"},
        "$otro": {".validate": false}
      }
    },

    "soloRanks": {
      ".read": "auth != null",
      "$categoria": {
        ".indexOn": [
          "puntos"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$categoria.matches(/^(club-minas-(easy|medium|hard)|club-snake-(classic|arcade|portals|reloj|espejo|laberinto)-(chico|mediano|grande|gigante)|club-tetris-(maraton|sprint|ultra)|club-sortem-(10|20|30)|club-bbtan-rondas|club-sopa-(racha|(facil|medio|dificil)-(8|12|15))|club-electro-(racha|puntos)|club-frontera-((torre|palacio|fabrica)-(50|abierto)|victorias)|club-sudoku-(racha|arcade|facil|medio|dificil|experto)|yemas-zombis-(nacht|kino|nuketown|riese|pueblo))$/) && newData.hasChildren(['nombre','puntos','tiempo','partida']) && (!data.exists() || newData.child('puntos').val() > data.child('puntos').val() || (newData.child('puntos').val() === data.child('puntos').val() && newData.child('tiempo').val() < data.child('tiempo').val()))",
          "nombre": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "puntos": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= ($categoria.beginsWith('club-snake-') || $categoria.beginsWith('club-tetris-') ? 1000000000 : $categoria === 'club-sudoku-arcade' || $categoria === 'club-electro-puntos' ? 1000000 : 100000) && (!$categoria.beginsWith('club-minas-') || newData.val() === 1) && (!$categoria.matches(/^club-sudoku-(facil|medio|dificil|experto)$/) || newData.val() === 1) && newData.val() % 1 === 0"
          },
          "tiempo": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 604800000 && newData.val() % 1 === 0"
          },
          "partida": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },

    "clueElenco": {
      ".read": "auth != null",
      ".write": false
    },
    "logros": {
      ".read": "auth != null",
      "$juego": {
        ".validate": "$juego.matches(/^(escondite|cartas|cuadritos|reversi|orbita|worms|cadena|flip7|cacho|uno|catan|presidente|spicy|tetris|yemas|clue|ajedrez|pokemon)$/)",
        "$uid": {
          "$id": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "$id.matches(/^[a-z0-9]{1,20}$/) && newData.isNumber() && newData.val() <= now"
          }
        }
      }
    },

    "ranks": {
      ".read": "auth != null",
      "$juego": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['jugadas', 'ultima']) && newData.child('ultima').isString() && newData.child('ultima').val() !== data.child('ultima').val() && newData.child('jugadas').val() === (data.exists() ? data.child('jugadas').val() : 0) + 1 && newData.child('puntos').val() <= (data.exists() ? data.child('puntos').val() : 0) + 3 && root.child('partidas').child(newData.child('ultima').val()).child('juego').val() === $juego && root.child('partidas').child(newData.child('ultima').val()).child('fin').exists() && root.child('partidas').child(newData.child('ultima').val()).child('jugadores').child($uid).exists()",
          "nombre": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "foto": { ".validate": "newData.isString() && newData.val().length <= 400 && (newData.val() === '' || newData.val().beginsWith('https://')) && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains('(') && !newData.val().contains(')') && !newData.val().contains(' ')" },
          "jugadas": { ".validate": "newData.isNumber()" },
          "ganadas": { ".validate": "newData.isNumber()" },
          "perdidas": { ".validate": "newData.isNumber()" },
          "empates": { ".validate": "newData.isNumber()" },
          "puntos": { ".validate": "newData.isNumber()" },
          "racha": { ".validate": "newData.isNumber()" },
          "mejorRacha": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": true }
        }
      }
    },

    "presence": {
      "$pid": {
        ".read": "auth != null && root.child('projects').child($pid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('projects').child($pid).child('members').child(auth.uid).child('role').val() === 'owner' || !root.child('projects').child($pid).exists())",
        "$client": {
          ".write": "auth != null && root.child('projects').child($pid).child('members').child(auth.uid).exists()"
        }
      }
    }
  }
}
