          "foto": { ".validate": "newData.isString() && newData.val().length <= 60000 && (newData.val() === '' || newData.val().beginsWith('https://') || newData.val().beginsWith('data:image/jpeg;base64,') || newData.val().beginsWith('data:image/png;base64,') || newData.val().beginsWith('data:image/webp;base64,')) && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains('(') && !newData.val().contains(')') && !newData.val().contains(' ') && !newData.val().contains('\\\\')" },
          "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6,6}$/)" },
          "marco": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{1,20}$/)" },
          "fondo": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{1,20}$/)" },
          "bio": { ".validate": "newData.isString() && newData.val().length <= 200" },
