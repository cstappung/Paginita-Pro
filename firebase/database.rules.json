            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6,6}$/)" },
            "foto": { ".validate": "newData.isString() && newData.val().length <= 400 && (newData.val() === '' || newData.val().beginsWith('https://')) && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains('(') && !newData.val().contains(')') && !newData.val().contains(' ')" },
            "orden": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": true }
          }
        },

        "jugadas": {
