{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "userProjects": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$pid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('projects').child($pid).child('members').child(auth.uid).child('role').val() === 'owner')"
        }
      }
    },

    "tokenIndex": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('projects').child(newData.child('pid').val()).child('members').child(auth.uid).child('role').val() !== 'view' && root.child('projects').child(newData.child('pid').val()).child('members').child(auth.uid).exists()) || (data.exists() && root.child('projects').child(data.child('pid').val()).child('members').child(auth.uid).child('role').val() === 'owner') || (data.exists() && !root.child('projects').child(data.child('pid').val()).exists()))"
      }
    },

    "projects": {
      "$pid": {
        ".write": "auth != null && (data.child('members').child(auth.uid).child('role').val() === 'owner' || (!data.exists() && newData.child('members').child(auth.uid).child('role').val() === 'owner'))",

        "meta": {
          ".read": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() !== 'view' && data.parent().child('members').child(auth.uid).exists()"
        },

        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$member": {
            ".read": "auth != null && auth.uid === $member",
            ".write": "auth != null && auth.uid === $member && ((!newData.exists() && data.child('role').val() !== 'owner') || (newData.exists() && newData.child('viaToken').isString() && root.child('tokenIndex').child(newData.child('viaToken').val()).child('pid').val() === $pid && root.child('tokenIndex').child(newData.child('viaToken').val()).child('role').val() === newData.child('role').val()))"
          }
        },

        "tokens": {
          ".read": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() !== 'view' && data.parent().child('members').child(auth.uid).exists()"
        },

        "invites": {
          ".read": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() !== 'view' && data.parent().child('members').child(auth.uid).exists()",
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() !== 'view' && data.parent().child('members').child(auth.uid).exists()"
        },

        "doc": {
          ".read": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() !== 'view' && data.parent().child('members').child(auth.uid).exists()"
        },

        "assetsIndex": {
          ".read": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() !== 'view' && data.parent().child('members').child(auth.uid).exists()"
        }
      }
    },

    "errors": {
      ".read": "auth != null",
      "$fp": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['app', 'mensaje', 'at']) && newData.child('mensaje').isString() && newData.child('mensaje').val().length <= 400 && newData.child('app').val().length <= 20",
        "pila": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "donde": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "nav": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "ver": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "veces": { ".validate": "newData.isNumber()" },
        "quien": {
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "$otro": { ".validate": true }
      }
    },

    "feedback": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['tipo', 'titulo', 'uid']) && newData.child('titulo').isString() && newData.child('titulo').val().length <= 200",
        "cuerpo": { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "pasos": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "adjuntos": { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "titulo": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "uid": { ".validate": "newData.val() === auth.uid" },
        "estado": {
          ".write": "auth != null",
          ".validate": "newData.val() === 'abierto' || newData.val() === 'hecho'"
        },
        "$otro": { ".validate": true }
      }
    },

    "partidas": {
      ".read": "auth != null",
      ".indexOn": ["estado"],
      "$pid": {
        ".write": "auth != null && ((!data.exists() && newData.child('anfitrion').val() === auth.uid && newData.child('jugadores').child(auth.uid).exists()) || (!newData.exists() && data.child('anfitrion').val() === auth.uid && !data.child('fin').exists()))",
        ".validate": "newData.hasChildren(['juego', 'estado', 'anfitrion'])",

        "juego": { ".validate": "newData.val() === 'escondite' || newData.val() === 'cartas' || newData.val() === 'cuadritos'" },
        "nombre": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "semilla": { ".validate": "newData.isNumber()" },
        "lado": { ".validate": "newData.isNumber()" },

        "estado": {
          ".write": "auth != null && root.child('partidas').child($pid).child('jugadores').child(auth.uid).exists()",
          ".validate": "newData.val() === 'esperando' || newData.val() === 'jugando' || newData.val() === 'fin'"
        },

        "fin": {
          ".write": "auth != null && root.child('partidas').child($pid).child('jugadores').child(auth.uid).exists() && (!data.exists() || data.child('ganador').val() === newData.child('ganador').val())",
          "motivo": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "$otro": { ".validate": true }
        },

        "jugadores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('partidas').child($pid).child('estado').val() === 'esperando'",
            ".validate": "newData.hasChildren(['nombre', 'orden'])",
            "nombre": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "foto": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "orden": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": true }
          }
        },

        "jugadas": {
          "$n": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('partidas').child($pid).child('jugadores').child(auth.uid).exists() && !root.child('partidas').child($pid).child('fin').exists()",
            ".validate": "newData.hasChildren(['t', 'uid']) && newData.child('t').isString() && newData.child('t').val().length <= 16 && $n.length >= 4",
            "h": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "sal": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$otro": { ".validate": true }
          }
        },

        "$otro": { ".validate": true }
      }
    },

    "misPartidas": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "ranks": {
      ".read": "auth != null",
      "$juego": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['jugadas', 'ultima']) && newData.child('ultima').isString() && newData.child('ultima').val() !== data.child('ultima').val() && newData.child('jugadas').val() === (data.exists() ? data.child('jugadas').val() : 0) + 1 && newData.child('puntos').val() <= (data.exists() ? data.child('puntos').val() : 0) + 3 && root.child('partidas').child(newData.child('ultima').val()).child('juego').val() === $juego && root.child('partidas').child(newData.child('ultima').val()).child('fin').exists() && root.child('partidas').child(newData.child('ultima').val()).child('jugadores').child($uid).exists()",
          "nombre": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "foto": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "jugadas": { ".validate": "newData.isNumber()" },
          "ganadas": { ".validate": "newData.isNumber()" },
          "perdidas": { ".validate": "newData.isNumber()" },
          "empates": { ".validate": "newData.isNumber()" },
          "puntos": { ".validate": "newData.isNumber()" },
          "racha": { ".validate": "newData.isNumber()" },
          "mejorRacha": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": true }
        }
      }
    },

    "presence": {
      "$pid": {
        ".read": "auth != null && root.child('projects').child($pid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('projects').child($pid).child('members').child(auth.uid).child('role').val() === 'owner' || !root.child('projects').child($pid).exists())",
        "$client": {
          ".write": "auth != null && root.child('projects').child($pid).child('members').child(auth.uid).exists()"
        }
      }
    }
  }
}
