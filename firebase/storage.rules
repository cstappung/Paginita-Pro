rules_version = '2';
// Storage: binarios de proyectos (imágenes, PDFs incluidos).
// El id de proyecto es aleatorio e inadivinable; el control fino de
// pertenencia vive en las reglas de Realtime Database, que estas reglas
// NO pueden consultar. Lo que sí se puede exigir aquí:
//   - que cada objeto diga quién lo subió (customMetadata.uid) y que solo
//     esa persona lo reemplace o lo borre. Los objetos de antes, sin esa
//     marca, siguen como estaban;
//   - que no sea HTML ni JavaScript: servidos desde un dominio de Google
//     serían una página de phishing gratis;
//   - un tope de tamaño.
// {fileName=**} admite subcarpetas (p. ej. figuras/logo.png).
// OJO: request.resource solo existe en escrituras — evaluarlo en una
// lectura hace fallar la regla (storage/unauthorized), por eso cada
// operación va por separado.
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{pid}/assets/{fileName=**} {
      function subidaValida() {
        return request.resource.size < 40 * 1024 * 1024
          && request.resource.metadata.get('uid', '') == request.auth.uid
          && !request.resource.contentType.matches('(?i).*(html|javascript|ecmascript).*');
      }
      function esDueno() {
        return resource == null
          || resource.metadata == null
          || resource.metadata.get('uid', '') == ''
          || resource.metadata.get('uid', '') == request.auth.uid;
      }
      allow read: if request.auth != null;
      // Subir encima de un archivo que ya existe también es «create» (verificado
      // en el emulador: «update» es solo cambiar metadatos), así que el dueño
      // se mira aquí.
      allow create: if request.auth != null && subidaValida() && esDueno();
      allow update: if request.auth != null && esDueno()
                    && request.resource.metadata.get('uid', '') == resource.metadata.get('uid', '');
      allow delete: if request.auth != null && esDueno();
    }
    // Proyecto Hero: canciones del juego (hero/songs_save/...). Se leen con la
    // sesión iniciada; nadie las escribe desde la web: se suben con gcloud,
    // que usa tu cuenta de Google Cloud y no pasa por estas reglas.
    match /hero/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Mario Kart Wii: las partidas de cada persona (un paquete .mkwp por cuenta,
    // juegos/mkw/web/navegador/nube.mjs). Solo su dueño la lee y la escribe;
    // tope de 8 MB (un paquete pesa ~0,1 MB) y nunca HTML ni JavaScript.
    match /mkw/{uid}/partidas.mkwp {
      function esSuyo() { return request.auth != null && request.auth.uid == uid; }
      allow read: if esSuyo();
      allow create, update: if esSuyo()
                            && request.resource.size < 8 * 1024 * 1024
                            && request.resource.metadata.get('uid', '') == uid
                            && !request.resource.contentType.matches('(?i).*(html|javascript|ecmascript).*');
      allow delete: if esSuyo();
    }
    // Mario Kart Wii: el fantasma del récord de Contrarreloj de cada persona (el .rkg que graba el juego: sus botones
    // de esa vuelta, ~0,2-3 KB), uno por pista y categoría (juegos/mkw/web/navegador/fantasma-pagina.mjs). Lo leen
    // todos los que tienen sesión (la Contrarreloj corre contra el del mejor de la tabla); lo escribe solo su dueño.
    match /mkw/fantasmas/{tabla}/{archivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && archivo == request.auth.uid + '.rkg'
                            && tabla.matches('^[0-9a-f]+-tt(150|200)$')
                            && request.resource.size < 64 * 1024
                            && request.resource.metadata.get('uid', '') == request.auth.uid
                            && !request.resource.contentType.matches('(?i).*(html|javascript|ecmascript).*');
      allow delete: if request.auth != null && archivo == request.auth.uid + '.rkg';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
